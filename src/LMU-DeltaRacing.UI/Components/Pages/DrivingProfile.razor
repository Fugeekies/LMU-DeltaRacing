@page "/driving-profile"
@inherits DashboardPage

<PageTitle>@T["PageTitle", T["Nav.DrivingProfile"]]</PageTitle>

<section class="page-heading">
    <div>
        <p class="eyebrow">@T["DrivingProfile.Eyebrow"]</p>
        <h1>@T["Nav.DrivingProfile"]</h1>
        <p class="page-subtitle">
            @(profile is null
                ? T["DrivingProfile.Subtitle"]
                : T["DrivingProfile.SubtitleOf", profile.Name, Texts.Plural("Common.Sessions", profile.Sessions), Texts.Plural("Common.Laps", profile.Player.Laps)])
        </p>
    </div>
</section>

<ResultsGate State="State">
@if (profile is null)
{
    <section class="panel empty-state">
        <span class="empty-icon" aria-hidden="true">○</span>
        <h3>@T["DrivingProfile.EmptyTitle"]</h3>
        <p>@T["DrivingProfile.EmptyText"]</p>
    </section>
}
else
{
    var cost = profile.Cost;
    @if (cost.Contacts > 0)
    {
        <section class="panel driving-cost" aria-label="@T["DrivingProfile.CostLabel"]">
            <div class="driving-cost-main">
                <p class="eyebrow">@T["DrivingProfile.CostEyebrow"]</p>
                <strong class="driving-cost-value">@DisplayFormat.Minutes(cost.TimeLost)</strong>
                <span class="summary-detail">
                    @T["DrivingProfile.LostOnContactLaps"]@(cost.TimeLostPerRace is { } perRace ? T["DrivingProfile.PerRace", FormatSeconds(perRace)].Value : string.Empty)
                </span>
                <span class="summary-detail">@T["DrivingProfile.CostNote"]</span>
            </div>
            <ul class="driving-takeaways">
                @foreach (var takeaway in cost.Takeaways)
                {
                    <li>@takeaway</li>
                }
            </ul>
            <div class="driving-cost-figures">
                <div><strong>@cost.Contacts</strong><span>@T["DrivingProfile.RaceContacts"]</span></div>
                <div><strong>@cost.FirstLapContacts</strong><span>@T["DrivingProfile.FirstLapContacts"]</span></div>
                <div><strong>@cost.PositionsLost</strong><span>@T["DrivingProfile.PositionsLost"]</span></div>
                <div><strong>@cost.ContactsWithDamage</strong><span>@T["DrivingProfile.WithDamage"]</span></div>
            </div>
            @if (cost.CostliestRace is { } worst)
            {
                <p class="driving-worst">
                    @T["DrivingProfile.CostliestRace"]
                    @if (worst.EventId is { } worstEvent)
                    {
                        <a href="@($"/race-details?event={Uri.EscapeDataString(worstEvent)}")">@worst.TrackVenue, @DisplayFormat.DateTime(worst.StartedAt)</a>
                    }
                    else
                    {
                        <span>@worst.TrackVenue, @DisplayFormat.DateTime(worst.StartedAt)</span>
                    }
                    (@T["DrivingProfile.Lost", FormatSeconds(worst.TimeLost)])
                </p>
            }
        </section>
    }

    <section class="driving-tiles" aria-label="@T["DrivingProfile.TilesLabel"]">
        @RenderTile(T["RaceDetails.Contacts"], profile.Player.ContactsPer100Laps, profile.Others.ContactsPer100Laps, profile.Player.Conduct.VehicleContacts)
        @RenderTile(T["RaceDetails.Obstacles"], profile.Player.ObstaclesPer100Laps, profile.Others.ObstaclesPer100Laps, profile.Player.Conduct.ObstacleContacts)
        @RenderTile(T["DrivingProfile.Warnings"], profile.Player.WarningsPer100Laps, profile.Others.WarningsPer100Laps, profile.Player.Conduct.Warnings)
        @RenderTile(T["RaceDetails.InvalidLaps"], profile.Qualifying.Rates.InvalidLapsPer100Laps, profile.OthersQualifying.InvalidLapsPer100Laps, profile.Player.Conduct.InvalidLaps)
        @RenderTile(T["DrivingProfile.Penalties"], profile.Player.PenaltiesPer100Laps, profile.Others.PenaltiesPer100Laps, profile.Player.Conduct.Penalties)
    </section>
    <p class="driving-note">@T["DrivingProfile.TilesNote"]</p>

    <section class="panel driving-panel">
        <div class="panel-heading">
            <div>
                <p class="eyebrow">@T["DrivingProfile.WhereEyebrow"]</p>
                <h2>@T["DrivingProfile.WhereTitle"]</h2>
            </div>
        </div>
        <div class="table-scroll">
            <table class="data-table driving-table" data-resizable-columns>
                <thead>
                    <tr>
                        <th scope="col"></th>
                        <th scope="col" class="numeric-cell">@T["DrivingProfile.Sessions"]</th>
                        <th scope="col" class="numeric-cell">@T["MyRaces.Laps"]</th>
                        <th scope="col" class="numeric-cell">@T["DrivingProfile.ContactsPer100"]</th>
                        <th scope="col" class="numeric-cell">@T["DrivingProfile.ObstaclesPer100"]</th>
                        <th scope="col" class="numeric-cell">@T["DrivingProfile.WarningsPer100"]</th>
                        <th scope="col" class="numeric-cell">@T["DrivingProfile.Penalties"]</th>
                        <th scope="col" class="numeric-cell">@T["DrivingProfile.TimeLost"]</th>
                        <th scope="col" class="numeric-cell">@T["DrivingProfile.RiskZone"]</th>
                    </tr>
                </thead>
                <tbody>
                    @RenderRows(T["DrivingProfile.GroupSession"], [profile.Race, profile.Qualifying])
                    @RenderRows(T["DrivingProfile.GroupCategory"], profile.ByCategory)
                    @RenderRows(T["DrivingProfile.GroupCircuit"], profile.ByCircuit)
                </tbody>
            </table>
        </div>
        <div class="sector-legend">
            <span>@T["DrivingProfile.SmallSampleNote"]</span>
            <span>@T["DrivingProfile.RiskZoneNote"]</span>
        </div>
    </section>

    <section class="panel driving-panel">
        <div class="panel-heading">
            <div>
                <p class="eyebrow">@T["Home.RecentForm"]</p>
                <h2>@T["DrivingProfile.LastRaces", profile.RecentRaces.Count]</h2>
            </div>
        </div>
        @if (profile.RecentRaces.Count == 0)
        {
            <div class="empty-state race-empty-state">
                <p>@T["DrivingProfile.NoRace"]</p>
            </div>
        }
        else
        {
            <div class="table-scroll">
                <table class="data-table driving-table" data-resizable-columns>
                    <thead>
                        <tr>
                            <th scope="col">@T["DrivingProfile.Date"]</th>
                            <th scope="col">@T["Common.Circuit"]</th>
                            <th scope="col">@T["Common.Category"]</th>
                            <th scope="col" class="numeric-cell">@T["RaceDetails.Contacts"]</th>
                            <th scope="col" class="numeric-cell">@T["RaceDetails.Obstacles"]</th>
                            <th scope="col" class="numeric-cell">@T["DrivingProfile.Warnings"]</th>
                            <th scope="col" class="numeric-cell">@T["DrivingProfile.Penalties"]</th>
                            <th scope="col" class="numeric-cell">@T["DrivingProfile.TimeLost"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var race in profile.RecentRaces)
                        {
                            <tr>
                                <td class="date-cell">
                                    @if (race.EventId is { } eventId)
                                    {
                                        <a href="@($"/race-details?event={Uri.EscapeDataString(eventId)}")">@DisplayFormat.DateTime(race.StartedAt)</a>
                                    }
                                    else
                                    {
                                        @DisplayFormat.DateTime(race.StartedAt)
                                    }
                                </td>
                                <td>@race.TrackVenue</td>
                                <td><span class="category-badge @CategoryStyle.CssClass(race.Category)">@race.Category</span></td>
                                <td class="numeric-cell">@race.Conduct.VehicleContacts</td>
                                <td class="numeric-cell">@race.Conduct.ObstacleContacts</td>
                                <td class="numeric-cell">@race.Conduct.Warnings</td>
                                <td class="numeric-cell">@race.Conduct.Penalties</td>
                                <td class="numeric-cell">@(race.TimeLost > TimeSpan.Zero ? FormatSeconds(race.TimeLost) : "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section class="driving-lists">
        @RenderCounts(T["DrivingProfile.MostHitDrivers"], profile.Opponents, T["DrivingProfile.NoVehicleContact"])
        @RenderCounts(T["DrivingProfile.ObstaclesTitle"], profile.Obstacles, T["DrivingProfile.NoObstacleContact"])
        @RenderCounts(T["DrivingProfile.PenaltyReasons"], profile.PenaltyReasons, T["DrivingProfile.NoPenalty"])
    </section>
}

</ResultsGate>

@code {
    private DriverDrivingProfile? profile;

    protected override void OnStateChanged()
    {
        profile = DrivingProfilePresentation.Create(State.Sessions, State.UserName);
    }

    private static string FormatSeconds(TimeSpan time) =>
        $"{time.TotalSeconds.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)} s";

    private static string FormatRate(double? rate) =>
        rate?.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture) ?? "—";

    /// <summary>
    /// Fewer incidents than the others is good news: lower is green, higher is red.
    /// </summary>
    private static string GetComparisonClass(double? rate, double? others) =>
        rate is { } value && others is { } reference
            ? value <= reference ? "delta-best" : "delta-loss"
            : "delta-unavailable";

    private static RenderFragment RenderTile(string label, double? rate, double? others, int total) =>
        @<article class="summary-card">
            <span class="summary-label">@label</span>
            <strong class="summary-value @GetComparisonClass(rate, others)">@FormatRate(rate)</strong>
            <span class="summary-detail">@Texts.Format("DrivingProfile.Others", FormatRate(others), total)</span>
        </article>;

    private static RenderFragment RenderRows(string title, IEnumerable<DrivingRow> rows) =>
        @<text>
            <tr class="driving-group"><th scope="rowgroup" colspan="9">@title</th></tr>
            @foreach (var row in rows.Where(row => row.Sessions > 0))
            {
                <tr>
                    <td>@row.Label</td>
                    <td class="numeric-cell">@row.Sessions</td>
                    <td class="numeric-cell">@row.Rates.Laps</td>
                    <td class="numeric-cell">@FormatRate(row.HasEnoughLaps ? row.Rates.ContactsPer100Laps : null)</td>
                    <td class="numeric-cell">@FormatRate(row.HasEnoughLaps ? row.Rates.ObstaclesPer100Laps : null)</td>
                    <td class="numeric-cell">@FormatRate(row.HasEnoughLaps ? row.Rates.WarningsPer100Laps : null)</td>
                    <td class="numeric-cell">@row.Rates.Conduct.Penalties</td>
                    <td class="numeric-cell">@(row.TimeLost > TimeSpan.Zero ? FormatSeconds(row.TimeLost) : "—")</td>
                    <td class="numeric-cell">@(row.RiskSector is { } sector ? Texts.Format("DrivingProfile.Sector", sector) : "—")</td>
                </tr>
            }
        </text>;

    private static RenderFragment RenderCounts(string title, IReadOnlyList<DrivingCount> counts, string empty) =>
        @<article class="panel driving-list">
            <h3 class="summary-label">@title</h3>
            @if (counts.Count == 0)
            {
                <p class="incident-empty">@empty</p>
            }
            else
            {
                <ol>
                    @foreach (var count in counts)
                    {
                        <li><span>@count.Label</span><strong>@count.Count</strong></li>
                    }
                </ol>
            }
        </article>;
}
