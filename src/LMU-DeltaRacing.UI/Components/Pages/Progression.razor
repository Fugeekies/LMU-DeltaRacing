@page "/progression"
@inject IConfiguration Configuration
@inherits DashboardPage
@inject DashboardSettingsStore SettingsStore

<PageTitle>@T["PageTitle", T["Nav.Progression"]]</PageTitle>

<section class="page-heading">
    <div>
        <p class="eyebrow">@T["MyRaces.Eyebrow"]</p>
        <h1>@T["Nav.Progression"]</h1>
        <p class="page-subtitle">@T["Progression.Subtitle"]</p>
    </div>
</section>

<ResultsGate State="State">
@if (circuits.Count == 0)
{
    <section class="panel empty-state">
        <span class="empty-icon" aria-hidden="true">○</span>
        <h3>@T["Home.EmptyTitle"]</h3>
        <p>@T["Home.EmptyText"]</p>
    </section>
}
else
{
    var circuit = GetSelectedCircuit();
    var (chart, layout) = GetChart(circuit);

    <section class="panel progression-panel">
        <div class="race-filters progression-filters" aria-label="@T["Progression.FiltersLabel"]">
            <label class="race-filter">
                <span>@T["Common.Circuit"]</span>
                <select value="@circuit.Key" @onchange="OnCircuitChanged" aria-label="@T["Progression.ChooseTrack"]">
                    @foreach (var option in circuits)
                    {
                        <option value="@option.Key">@option.Label</option>
                    }
                </select>
            </label>
            <label class="race-filter">
                <span>@T["Common.Category"]</span>
                <select value="@selectedCategory" @onchange="OnCategoryChanged" aria-label="@T["Progression.ChooseCategory"]">
                    @foreach (var category in circuit.Categories)
                    {
                        <option value="@category">@category</option>
                    }
                </select>
            </label>
        </div>

        <div class="progression-settings" aria-label="@T["Progression.SettingsLabel"]">
            <div class="segmented-group">
                <span>@T["Progression.Period"]</span>
                <div class="segmented" role="group" aria-label="@T["Progression.PeriodLabel"]">
                    @foreach (var (value, text) in Granularities)
                    {
                        <button type="button" class="@(settings.Granularity == value ? "is-active" : null)" aria-pressed="@(settings.Granularity == value ? "true" : "false")"
                                @onclick="() => UpdateSettings(settings with { Granularity = value })">@text</button>
                    }
                </div>
            </div>
            <div class="segmented-group">
                <span>@T["Progression.PlottedValue"]</span>
                <div class="segmented" role="group" aria-label="@T["Progression.PlottedValueLabel"]">
                    @foreach (var (value, text) in Aggregates)
                    {
                        <button type="button" class="@(settings.Aggregate == value ? "is-active" : null)" aria-pressed="@(settings.Aggregate == value ? "true" : "false")"
                                @onclick="() => UpdateSettings(settings with { Aggregate = value })">@text</button>
                    }
                </div>
            </div>
            <div class="segmented-group">
                <span>@T["Progression.Display"]</span>
                <div class="segmented" role="group" aria-label="@T["Progression.DisplayLabel"]">
                    @foreach (var (value, text) in Modes)
                    {
                        <button type="button" class="@(settings.Mode == value ? "is-active" : null)" aria-pressed="@(settings.Mode == value ? "true" : "false")"
                                @onclick="() => UpdateSettings(settings with { Mode = value })">@text</button>
                    }
                </div>
            </div>
            @if (settings.Mode == ProgressionMode.PerCar)
            {
                <div class="segmented-group">
                    <span>@T["Progression.Session"]</span>
                    <div class="segmented" role="group" aria-label="@T["Progression.SessionLabel"]">
                        @foreach (var (value, text) in SessionTypes)
                        {
                            <button type="button" class="@(settings.Session == value ? "is-active" : null)" aria-pressed="@(settings.Session == value ? "true" : "false")"
                                    @onclick="() => UpdateSettings(settings with { Session = value })">@text</button>
                        }
                    </div>
                </div>
            }
        </div>

        @if (chart.Series.Count == 0)
        {
            <div class="empty-state race-empty-state">
                <p>@T["Progression.NoLap"]</p>
            </div>
        }
        else
        {
            @if (layout.Series.Count > 0)
            {
                <div class="progression-summary">
                    @foreach (var series in layout.Series.Select(series => series.Series))
                    {
                        <div class="progression-summary-row">
                            <span class="progression-series-name">
                                <i class="home-swatch" style="background: @series.Color" aria-hidden="true"></i>@series.Label
                            </span>
                            <span><small>@T["Progression.Record"]</small> <strong>@ProgressionChartLayout.FormatTime(series.Record.Time)</strong> <em>(@DisplayFormat.Day(series.Record.At))</em></span>
                            <span><small>@T["Progression.Start"]</small> <strong>@ProgressionChartLayout.FormatTime(series.First.Value)</strong> <em>(@ProgressionPeriods.Label(series.First.PeriodStart, settings.Granularity))</em></span>
                            <span><small>@T["Progression.Today"]</small> <strong>@ProgressionChartLayout.FormatTime(series.Last.Value)</strong> <em>(@ProgressionPeriods.Label(series.Last.PeriodStart, settings.Granularity))</em></span>
                            <span>@RenderGain(series.Gain)</span>
                        </div>
                    }
                </div>
            }

            <div class="progression-chart-area">
                <svg class="progression-chart" viewBox="0 0 @Format(layout.Width) @Format(layout.Height)" role="img"
                     aria-label="@T["Progression.ChartLabel", GetGranularityLabel(settings.Granularity)]">
                    @foreach (var tick in layout.YTicks)
                    {
                        <line class="chart-grid" x1="@Format(layout.PlotLeft)" x2="@Format(layout.PlotRight)" y1="@Format(tick.Y)" y2="@Format(tick.Y)" />
                        @AxisLabel(layout.PlotLeft - 8, tick.Y + 4, "end", tick.Label)
                    }
                    @foreach (var empty in layout.EmptyPeriods)
                    {
                        <rect class="chart-empty" x="@Format(Math.Min(empty.X1, empty.X2) - 3)" y="@Format(layout.PlotBottom - 4)" width="@Format(Math.Abs(empty.X2 - empty.X1) + 6)" height="4">
                            <title>@T["Progression.NoSessionPeriod", empty.End == empty.Start ? ProgressionPeriods.Label(empty.Start, settings.Granularity) : $"{ProgressionPeriods.Label(empty.Start, settings.Granularity)} → {ProgressionPeriods.Label(empty.End, settings.Granularity)}"]</title>
                        </rect>
                    }
                    @foreach (var tick in layout.XTicks)
                    {
                        <line class="chart-grid chart-grid-x" x1="@Format(tick.X)" x2="@Format(tick.X)" y1="@Format(layout.PlotTop)" y2="@Format(layout.PlotBottom)" />
                        @AxisLabel(tick.X, layout.PlotBottom + 22, "middle", tick.Label)
                    }
                    @foreach (var series in layout.Series)
                    {
                        <g class="chart-series">
                            @foreach (var band in series.BandPaths)
                            {
                                <path class="chart-band" d="@band" fill="@series.Series.Color" stroke="@series.Series.Color" />
                            }
                            <line class="chart-record" x1="@Format(layout.PlotLeft)" x2="@Format(layout.PlotRight)" y1="@Format(series.RecordY)" y2="@Format(series.RecordY)" stroke="@series.Series.Color">
                                <title>@T["Progression.RecordOf", series.Series.Label, ProgressionChartLayout.FormatTime(series.Series.Record.Time)]</title>
                            </line>
                            @if (series.LinePath.Length > 0)
                            {
                                <path class="chart-line" d="@series.LinePath" stroke="@series.Series.Color" />
                            }
                            @foreach (var point in series.Points)
                            {
                                var isSelected = IsSelected(series.Series, point.Point);
                                <circle class="chart-point @(isSelected ? "is-selected" : null)" cx="@Format(point.X)" cy="@Format(point.Y)" r="@(isSelected ? 6 : 4)"
                                        fill="@series.Series.Color" tabindex="0"
                                        aria-label="@T["Progression.PointLabel", series.Series.Label, ProgressionPeriods.Label(point.Point.PeriodStart, settings.Granularity), ProgressionChartLayout.FormatTime(point.Point.Value)]"
                                        @onmouseenter="() => SelectPoint(series.Series, point.Point)"
                                        @onfocus="() => SelectPoint(series.Series, point.Point)"
                                        @onclick="() => SelectPoint(series.Series, point.Point)" />
                            }
                        </g>
                    }
                </svg>

                <aside class="progression-detail" aria-live="polite">
                    @if (GetSelectedPoint(layout) is { } selected)
                    {
                        <p class="summary-label">@ProgressionPeriods.Label(selected.Point.PeriodStart, settings.Granularity).ToUpperInvariant()</p>
                        @RenderDetail(selected.Series, selected.Point)
                    }
                    else
                    {
                        <p class="summary-label">@T["Progression.LastPeriod"]</p>
                        @foreach (var series in layout.Series.Select(series => series.Series))
                        {
                            @RenderDetail(series, series.Last, showPeriod: true)
                        }
                    }
                </aside>
            </div>

            <div class="progression-legend" aria-label="@T["Progression.LegendLabel"]">
                @foreach (var series in chart.Series)
                {
                    var isHidden = hiddenSeries.Contains(series.Key);
                    <button type="button" class="legend-item @(isHidden ? "is-hidden" : null)" aria-pressed="@(isHidden ? "false" : "true")" @onclick="() => ToggleSeries(series.Key)">
                        <i class="home-swatch" style="background: @series.Color" aria-hidden="true"></i>
                        @series.Label <span>(@Texts.Plural("Common.Sessions", series.SessionCount))</span>
                    </button>
                }
                <span class="legend-note">@T["Progression.LegendLines"] <i class="legend-empty" aria-hidden="true"></i> @T["Progression.LegendEmpty"]</span>
            </div>

            <div class="progression-table">
                <button type="button" class="button button-secondary" aria-expanded="@(showsTable ? "true" : "false")" @onclick="() => showsTable = !showsTable">
                    @(showsTable ? T["Progression.HideDetails"] : T["Progression.ShowDetails"])
                </button>
                @if (showsTable)
                {
                    <div class="table-scroll">
                        <table class="data-table" data-resizable-columns>
                            <thead>
                                <tr>
                                    <th scope="col">@T["Progression.Period"]</th>
                                    <th scope="col">@T["Progression.Curve"]</th>
                                    <th scope="col" class="numeric-cell">@T["Progression.MinUpper"]</th>
                                    <th scope="col" class="numeric-cell">@T["Progression.AverageUpper"]</th>
                                    <th scope="col" class="numeric-cell">@T["Progression.MaxUpper"]</th>
                                    <th scope="col" class="numeric-cell">@T["DrivingProfile.Sessions"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in layout.Series
                                    .SelectMany(series => series.Series.Points.Select(point => (series.Series, Point: point)))
                                    .OrderByDescending(row => row.Point.PeriodStart)
                                    .ThenBy(row => row.Series.Label, StringComparer.OrdinalIgnoreCase))
                                {
                                    <tr>
                                        <td>@ProgressionPeriods.Label(row.Point.PeriodStart, settings.Granularity)</td>
                                        <td><i class="home-swatch" style="background: @row.Series.Color" aria-hidden="true"></i>@row.Series.Label</td>
                                        <td class="numeric-cell">@ProgressionChartLayout.FormatTime(row.Point.Min)</td>
                                        <td class="numeric-cell">@ProgressionChartLayout.FormatTime(row.Point.Average)</td>
                                        <td class="numeric-cell">@ProgressionChartLayout.FormatTime(row.Point.Max)</td>
                                        <td class="numeric-cell">@row.Point.SessionCount</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        }
    </section>

    @* Records and sessions follow the circuit and category chosen above, every car included. *@
    var records = PersonalRecordsPresentation.Create(State.Sessions, State.UserName, circuit.TrackVenue, circuit.TrackCourse, selectedCategory);
    @if (records.Sessions.Count > 0)
    {
        <section class="panel progression-records" aria-label="@T["Records.Title"]">
            <div class="panel-heading">
                <div>
                    <h2>@T["Records.Title"]</h2>
                    <p class="page-subtitle">@T["Records.Subtitle"]</p>
                </div>
            </div>
            <div class="table-scroll">
                <table class="data-table lap-analysis-table" data-resizable-columns>
                    <thead>
                        <tr>
                            <th scope="col">@T["Records.Car"]</th>
                            <th scope="col" class="numeric-cell">@T["LapAnalysis.BestLap"]</th>
                            <th scope="col" class="numeric-cell">@T["LapAnalysis.TopSpeed"]</th>
                            <th scope="col" class="numeric-cell">@T["Records.Sessions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var car in records.Cars)
                        {
                            <tr>
                                <td>@car.Car</td>
                                <td class="numeric-cell stacked-cell">
                                    <span class="lap-time">@DisplayFormat.Lap(car.BestLap?.Time)</span>
                                    @if (car.BestLap is { } lap)
                                    {
                                        <span class="cell-sub">@FormatSession(lap.StartedAt, lap.Kind)</span>
                                    }
                                </td>
                                <td class="numeric-cell stacked-cell">
                                    <span>@DisplayFormat.Speed(car.TopSpeed?.Speed)</span>
                                    @if (car.TopSpeed is { } speed)
                                    {
                                        <span class="cell-sub">@FormatSession(speed.StartedAt, speed.Kind)</span>
                                    }
                                </td>
                                <td class="numeric-cell">@car.Sessions</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="panel-heading">
                <div>
                    <h2>@T["Comparison.Title"]</h2>
                    <p class="page-subtitle">@T["Comparison.Subtitle"]</p>
                </div>
            </div>
            <div class="table-scroll lap-analysis-laps">
                <table class="data-table lap-analysis-table" data-resizable-columns>
                    <thead>
                        <tr>
                            <th scope="col">@T["Comparison.Date"]</th>
                            <th scope="col">@T["Comparison.Session"]</th>
                            <th scope="col">@T["Records.Car"]</th>
                            <th scope="col" class="numeric-cell">@T["Comparison.ClassPosition"]</th>
                            <th scope="col" class="numeric-cell">@T["LapAnalysis.BestLap"] <span class="th-sub">@T["Comparison.GapToRecord"]</span></th>
                            <th scope="col" class="numeric-cell">@T["LapAnalysis.Pace"]</th>
                            <th scope="col" class="numeric-cell">@T["LapAnalysis.Regularity"]</th>
                            <th scope="col" class="numeric-cell">@T["LapAnalysis.TopSpeed"]</th>
                            <th scope="col" class="numeric-cell">@T["LapAnalysis.PitStops"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in records.Sessions)
                        {
                            <tr>
                                <td>@DisplayFormat.DateTime(row.StartedAt)</td>
                                <td>@SessionLabel(row.Kind)</td>
                                <td>@row.Car</td>
                                <td class="numeric-cell">@(row.ClassPosition is { } position ? $"P{position}" : DisplayFormat.Missing)</td>
                                <td class="numeric-cell stacked-cell">
                                    <span class="lap-time">
                                        @DisplayFormat.Lap(row.BestLap)
                                        @if (row.BrokeLapRecord)
                                        {
                                            <span class="record-badge" title="@T["Comparison.LapRecordTitle"]">@T["Comparison.Record"]</span>
                                        }
                                    </span>
                                    <span class="cell-sub delta-time @(row.GapToRecord == TimeSpan.Zero ? "delta-best" : "delta-loss")">@DisplayFormat.Delta(row.GapToRecord)</span>
                                </td>
                                <td class="numeric-cell">@DisplayFormat.Lap(row.Pace)</td>
                                <td class="numeric-cell">@DisplayFormat.Deviation(row.Deviation)</td>
                                <td class="numeric-cell">
                                    @DisplayFormat.Speed(row.TopSpeed)
                                    @if (row.BrokeSpeedRecord)
                                    {
                                        <span class="record-badge" title="@T["Comparison.SpeedRecordTitle"]">@T["Comparison.Record"]</span>
                                    }
                                </td>
                                <td class="numeric-cell">@(row.PitStops?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? DisplayFormat.Missing)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
}

</ResultsGate>

@code {
    private static (ProgressionGranularity Value, string Text)[] Granularities =>
        [(ProgressionGranularity.Day, Texts.Get("Progression.Day")), (ProgressionGranularity.Week, Texts.Get("Progression.Week")), (ProgressionGranularity.Month, Texts.Get("Progression.Month")), (ProgressionGranularity.Year, Texts.Get("Progression.Year"))];

    private static (ProgressionAggregate Value, string Text)[] Aggregates =>
        [(ProgressionAggregate.Min, Texts.Get("Progression.Min")), (ProgressionAggregate.Average, Texts.Get("Progression.Average")), (ProgressionAggregate.Max, Texts.Get("Progression.Max"))];

    private static (ProgressionMode Value, string Text)[] Modes =>
        [(ProgressionMode.MixedCars, Texts.Get("Progression.MixedCars")), (ProgressionMode.PerCar, Texts.Get("Progression.PerCar"))];

    private static (ProgressionSession Value, string Text)[] SessionTypes =>
        [(ProgressionSession.Race, Texts.Get("Progression.Race")), (ProgressionSession.Qualifying, Texts.Get("Progression.Qualifying"))];

    private IReadOnlyList<ProgressionCircuit> circuits = [];
    private ProgressionSettings settings = ProgressionSettings.Default;
    private string selectedCircuitKey = string.Empty;
    private string selectedCategory = string.Empty;
    private readonly HashSet<string> hiddenSeries = new(StringComparer.Ordinal);
    private (string SeriesKey, DateTime PeriodStart)? selectedPoint;
    private bool showsTable;
    private object? chartInputs;
    private (ProgressionChart Chart, ProgressionChartLayout Layout) chartCache;

    /// <summary>
    /// Gets or sets the venue to open, as linked from « Mes courses ».
    /// </summary>
    [SupplyParameterFromQuery(Name = "venue")]
    public string? Venue { get; set; }

    /// <summary>
    /// Gets or sets the layout to open, as linked from « Mes courses ».
    /// </summary>
    [SupplyParameterFromQuery(Name = "course")]
    public string? Course { get; set; }

    /// <summary>
    /// Gets or sets the category to open, as linked from « Mes courses ».
    /// </summary>
    [SupplyParameterFromQuery(Name = "category")]
    public string? Category { get; set; }

    protected override void OnInitialized()
    {
        settings = ProgressionSettings.Load(Configuration);
        base.OnInitialized();
    }

    protected override void OnParametersSet()
    {
        if (circuits.FirstOrDefault(circuit =>
                string.Equals(circuit.TrackVenue, Venue, StringComparison.OrdinalIgnoreCase)
                && string.Equals(circuit.TrackCourse, Course, StringComparison.OrdinalIgnoreCase)) is { } linked)
        {
            SelectCircuit(linked, Category);
        }
    }

    protected override void OnStateChanged()
    {
        circuits = ProgressionPresentation.GetCircuits(State.Sessions, State.UserName);

        // Live imports keep the current selection; it is replaced only when it no longer exists.
        if (circuits.FirstOrDefault(circuit => circuit.Key == selectedCircuitKey) is { } current)
        {
            SelectCircuit(current, selectedCategory);
        }
        else if (ProgressionPresentation.GetDefaultSelection(State.Sessions, State.UserName) is { } selection
                 && circuits.FirstOrDefault(circuit =>
                     string.Equals(circuit.TrackVenue, selection.TrackVenue, StringComparison.OrdinalIgnoreCase)
                     && string.Equals(circuit.TrackCourse, selection.TrackCourse, StringComparison.OrdinalIgnoreCase)) is { } latest)
        {
            SelectCircuit(latest, selection.Category);
        }
    }

    private static string SessionLabel(SessionKind kind) =>
        kind == SessionKind.Qualifying ? Texts.Get("Progression.Qualifying") : Texts.Get("Progression.Race");

    private static string FormatSession(DateTimeOffset startedAt, SessionKind kind) =>
        $"{DisplayFormat.Day(startedAt)} · {SessionLabel(kind)}";

    private ProgressionCircuit GetSelectedCircuit() =>
        circuits.FirstOrDefault(circuit => circuit.Key == selectedCircuitKey) ?? circuits[0];

    /// <summary>
    /// Returns the chart of a circuit. Hovering a point renders the page again: the chart is
    /// recalculated only when the sessions, the selection, the settings or the hidden series change.
    /// </summary>
    private (ProgressionChart Chart, ProgressionChartLayout Layout) GetChart(ProgressionCircuit circuit)
    {
        var inputs = (State.Sessions, State.UserName, circuit.Key, selectedCategory, settings, string.Join('|', hiddenSeries.Order()));
        if (!inputs.Equals(chartInputs))
        {
            var chart = ProgressionPresentation.Create(
                State.Sessions,
                State.UserName,
                circuit.TrackVenue,
                circuit.TrackCourse,
                selectedCategory,
                settings,
                TimeZoneInfo.Local);
            chartCache = (chart, ProgressionChartLayout.Create(chart, hiddenSeries));
            chartInputs = inputs;
        }

        return chartCache;
    }

    private void SelectCircuit(ProgressionCircuit circuit, string? category)
    {
        if (circuit.Key != selectedCircuitKey)
        {
            ResetChartState();
        }

        selectedCircuitKey = circuit.Key;
        var nextCategory = category is not null && circuit.Categories.Contains(category) ? category : circuit.LatestCategory;
        if (nextCategory != selectedCategory)
        {
            ResetChartState();
        }

        selectedCategory = nextCategory;
    }

    private void OnCircuitChanged(ChangeEventArgs args)
    {
        if (circuits.FirstOrDefault(circuit => circuit.Key == args.Value?.ToString()) is { } circuit)
        {
            SelectCircuit(circuit, selectedCategory);
        }
    }

    private void OnCategoryChanged(ChangeEventArgs args) =>
        SelectCircuit(GetSelectedCircuit(), args.Value?.ToString());

    private void UpdateSettings(ProgressionSettings next)
    {
        if (next == settings)
        {
            return;
        }

        if (next.Mode != settings.Mode || next.Session != settings.Session)
        {
            hiddenSeries.Clear();
        }

        settings = next;
        selectedPoint = null;
        SettingsStore.SaveProgressionSettings(settings);
    }

    private void ResetChartState()
    {
        hiddenSeries.Clear();
        selectedPoint = null;
    }

    private void ToggleSeries(string key)
    {
        if (!hiddenSeries.Remove(key))
        {
            hiddenSeries.Add(key);
        }

        selectedPoint = null;
    }

    private void SelectPoint(ProgressionSeries series, ProgressionPoint point) =>
        selectedPoint = (series.Key, point.PeriodStart);

    private bool IsSelected(ProgressionSeries series, ProgressionPoint point) =>
        selectedPoint is { } selected && selected.SeriesKey == series.Key && selected.PeriodStart == point.PeriodStart;

    private (ProgressionSeries Series, ProgressionPoint Point)? GetSelectedPoint(ProgressionChartLayout layout)
    {
        if (selectedPoint is not { } selected)
        {
            return null;
        }

        var series = layout.Series.Select(series => series.Series).FirstOrDefault(series => series.Key == selected.SeriesKey);
        var point = series?.Points.FirstOrDefault(point => point.PeriodStart == selected.PeriodStart);
        return series is not null && point is not null ? (series, point) : null;
    }

    private RenderFragment RenderDetail(ProgressionSeries series, ProgressionPoint point, bool showPeriod = false) =>
        @<div class="progression-detail-series">
            <p class="progression-series-name">
                <i class="home-swatch" style="background: @series.Color" aria-hidden="true"></i>@series.Label
                @if (showPeriod)
                {
                    <em>@ProgressionPeriods.Label(point.PeriodStart, settings.Granularity)</em>
                }
            </p>
            @* The row of the plotted value is highlighted: it is the point drawn on the line. *@
            <dl>
                <div class="@(settings.Aggregate == ProgressionAggregate.Min ? "is-plotted" : null)"><dt>@T["Progression.Min"]</dt><dd>@ProgressionChartLayout.FormatTime(point.Min)</dd></div>
                <div class="@(settings.Aggregate == ProgressionAggregate.Average ? "is-plotted" : null)"><dt>@T["Progression.Average"]</dt><dd>@ProgressionChartLayout.FormatTime(point.Average)</dd></div>
                <div class="@(settings.Aggregate == ProgressionAggregate.Max ? "is-plotted" : null)"><dt>@T["Progression.Max"]</dt><dd>@ProgressionChartLayout.FormatTime(point.Max)</dd></div>
                <div><dt>@T["Progression.Sessions"]</dt><dd>@point.SessionCount</dd></div>
            </dl>
        </div>;

    private static RenderFragment RenderGain(TimeSpan? gain) =>
        @<text>
            @if (gain is { } value)
            {
                var text = string.Create(
                    System.Globalization.CultureInfo.InvariantCulture,
                    $"{(value > TimeSpan.Zero ? "+" : value < TimeSpan.Zero ? "−" : string.Empty)}{Math.Abs(value.TotalSeconds):0.000} s");
                <strong class="@(value < TimeSpan.Zero ? "delta-gain" : value > TimeSpan.Zero ? "delta-loss" : null)">@text</strong>
            }
            else
            {
                <span class="progression-muted">@Texts.Get("Progression.SinglePeriod")</span>
            }
        </text>;

    private static string GetGranularityLabel(ProgressionGranularity granularity) =>
        granularity switch
        {
            ProgressionGranularity.Day => Texts.Get("Progression.DayLower"),
            ProgressionGranularity.Week => Texts.Get("Progression.WeekLower"),
            ProgressionGranularity.Year => Texts.Get("Progression.YearLower"),
            _ => Texts.Get("Progression.MonthLower")
        };

    /// <summary>
    /// Writes an SVG axis label. Razor reserves the <c>text</c> tag, so the element is built as encoded markup.
    /// </summary>
    private static MarkupString AxisLabel(double x, double y, string anchor, string label) =>
        new($"<text class=\"chart-axis-label\" x=\"{Format(x)}\" y=\"{Format(y)}\" text-anchor=\"{anchor}\">{System.Net.WebUtility.HtmlEncode(label)}</text>");

    private static string Format(double value) =>
        value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
}
