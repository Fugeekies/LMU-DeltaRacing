@page "/settings"
@inject IConfiguration Configuration
@inherits DashboardPage
@inject DashboardSettingsStore SettingsStore
@inject WindowsFolderPicker FolderPicker

<PageTitle>@T["PageTitle", T["Nav.Settings"]]</PageTitle>

<section class="page-heading settings-heading">
    <div>
        <p class="eyebrow">@T["Settings.Eyebrow"]</p>
        <h1>@T["Nav.Settings"]</h1>
        <p class="page-subtitle">@T["Settings.Subtitle"]</p>
    </div>
</section>

<section class="panel settings-panel" aria-labelledby="results-settings-heading">
    <div class="panel-heading">
        <div>
            <p class="eyebrow">@T["Settings.FilesEyebrow"]</p>
            <h2 id="results-settings-heading">@T["Settings.ResultsFolder"]</h2>
        </div>
    </div>

    <div class="settings-content">
        <label class="settings-label" for="results-directory">
            @T["Settings.FolderPath"] <span>(UserData/Log/Results)</span>
        </label>
        <div class="directory-picker">
            <input id="results-directory"
                   class="settings-input"
                   type="text"
                   @bind="resultsDirectory"
                   @bind:after="ValidateSelectedDirectory"
                   placeholder="@GetDefaultDirectoryPlaceholder()"
                   autocomplete="off"
                   spellcheck="false" />
            <button class="button button-secondary"
                    type="button"
                    @onclick="BrowseForDirectoryAsync"
                    disabled="@(!OperatingSystem.IsWindows() || isBusy)">
                @T["Settings.Browse"]
            </button>
        </div>

        @if (directoryStatus is not null)
        {
            <div class="directory-status @(directoryStatus.IsValid ? "status-valid" : "status-invalid")"
                 role="status"
                 aria-live="polite">
                <span class="status-dot @(directoryStatus.IsValid ? "is-live" : "is-error")" aria-hidden="true"></span>
                @if (directoryStatus.IsValid)
                {
                    <span>@T["Settings.ValidFolder", directoryStatus.XmlFileCount]</span>
                    <code>@directoryStatus.DirectoryPath</code>
                }
                else
                {
                    <span>@T["Settings.InvalidFolder"]</span>
                    <span>@directoryStatus.ErrorMessage</span>
                }
            </div>
        }
        else
        {
            <div class="directory-status">
                <span class="status-dot is-idle" aria-hidden="true"></span>
                <span>@T["Settings.CheckFolder"]</span>
            </div>
        }

        <div class="settings-actions">
            <button class="button button-primary"
                    type="button"
                    @onclick="ApplyResultsDirectoryAsync"
                    disabled="@(isBusy || directoryStatus is { IsValid: false })">
                @(isReloading ? T["Settings.Loading"] : T["Settings.Apply"])
            </button>
            <span class="settings-help">@T["Settings.ApplyHelp"]</span>
            @if (!OperatingSystem.IsWindows())
            {
                <span class="settings-help">@T["Settings.PickerWindowsOnly"]</span>
            }
        </div>
    </div>
</section>

<section class="panel settings-panel" aria-labelledby="driver-settings-heading">
    <div class="panel-heading">
        <div>
            <p class="eyebrow">@T["Settings.DriverEyebrow"]</p>
            <h2 id="driver-settings-heading">@T["Settings.MainDriver"]</h2>
        </div>
    </div>
    <div class="settings-content">
        <label class="settings-label" for="user-name">@T["Settings.MainDriverLabel"]</label>
        <select id="user-name"
                class="settings-input"
                value="@selectedUserName"
                @onchange="SaveSelectedUserName"
                disabled="@(State.IsLoading || State.DriverFrequencies.Count == 0)">
            @if (string.IsNullOrWhiteSpace(selectedUserName))
            {
                <option value="">@T["Settings.DetectionPending"]</option>
            }
            else if (!State.DriverFrequencies.Any(driver =>
                string.Equals(driver.Name, selectedUserName, StringComparison.OrdinalIgnoreCase)))
            {
                <option value="@selectedUserName">@T["Settings.AbsentDriver", selectedUserName]</option>
            }
            @foreach (var driver in State.DriverFrequencies)
            {
                <option value="@driver.Name">
                    @T["Settings.DriverFrequency", driver.Name, driver.Percentage.ToString("P1"), driver.AppearanceCount, driver.TotalResults]
                </option>
            }
        </select>
        <p class="settings-help">@T["Settings.MainDriverHelp"]</p>
    </div>
</section>

<section class="panel settings-panel" aria-labelledby="merge-settings-heading">
    <div class="panel-heading">
        <div>
            <p class="eyebrow">@T["Settings.MergeEyebrow"]</p>
            <h2 id="merge-settings-heading">@T["Settings.Merge"]</h2>
        </div>
    </div>
    <div class="settings-content">
        <p class="settings-help">@T["Settings.MergeHelp"]</p>
        <div class="merge-picker">
            <label class="settings-label">
                @T["Settings.MergeFrom"]
                <select class="settings-input" @bind="mergeFrom" @bind:after="UpdateMergeWarning" disabled="@(isBusy || State.DriverFrequencies.Count == 0)">
                    <option value="">@T["Settings.ChooseDriver"]</option>
                    @foreach (var driver in State.DriverFrequencies)
                    {
                        <option value="@driver.Name">@T["Settings.DriverFiles", driver.Name, driver.AppearanceCount]</option>
                    }
                </select>
            </label>
            <label class="settings-label">
                @T["Settings.MergeTo"]
                <select class="settings-input" @bind="mergeTo" @bind:after="UpdateMergeWarning" disabled="@(isBusy || State.DriverFrequencies.Count == 0)">
                    <option value="">@T["Settings.ChooseDriver"]</option>
                    @foreach (var driver in State.DriverFrequencies)
                    {
                        <option value="@driver.Name">@T["Settings.DriverFiles", driver.Name, driver.AppearanceCount]</option>
                    }
                </select>
            </label>
            <button class="button button-primary"
                    type="button"
                    @onclick="MergeDrivers"
                    disabled="@(isBusy || !CanMerge())">
                @T["Settings.MergeButton"]
            </button>
        </div>

        @if (mergeWarningCount > 0)
        {
            <div class="notice notice-warning merge-warning" role="alert">
                <span class="notice-symbol" aria-hidden="true">!</span>
                <p>@T["Settings.MergeWarning", mergeWarningCount]</p>
            </div>
        }

        @if (State.DriverMerges.Count > 0)
        {
            <ul class="merge-list" aria-label="@T["Settings.MergesLabel"]">
                @foreach (var merge in State.DriverMerges)
                {
                    var sharedSessions = sharedSessionsByMerge.GetValueOrDefault(merge);
                    <li>
                        <span><strong>@merge.From</strong> → <strong>@merge.To</strong></span>
                        @if (sharedSessions > 0)
                        {
                            <span class="merge-list-warning" title="@T["Settings.SharedSessionsHint"]">⚠ @T["Settings.SharedSessions", sharedSessions]</span>
                        }
                        <button class="button button-secondary" type="button" @onclick="() => CancelMerge(merge.From)" disabled="@isBusy">@T["Settings.CancelMerge"]</button>
                    </li>
                }
            </ul>
        }
    </div>
</section>

<section class="panel settings-panel watcher-settings" aria-labelledby="watcher-settings-heading">
    <div class="panel-heading">
        <div>
            <p class="eyebrow">@T["Settings.WatcherEyebrow"]</p>
            <h2 id="watcher-settings-heading">@T["Settings.AutoStart"]</h2>
        </div>
    </div>
    <div class="settings-content watcher-preference">
        <label class="settings-checkbox">
            <input type="checkbox" @bind="watchOnStartup" @bind:after="SaveWatchOnStartup" disabled="@isBusy" />
            <span>@T["Settings.AutoStartLabel"]</span>
        </label>
        <p class="settings-help">@T["Settings.AutoStartHelp"]</p>
    </div>
</section>

<section class="panel settings-panel" aria-labelledby="practice-settings-heading">
    <div class="panel-heading">
        <div>
            <p class="eyebrow">@T["Settings.DataEyebrow"]</p>
            <h2 id="practice-settings-heading">@T["Settings.Practice"]</h2>
        </div>
    </div>
    <div class="settings-content">
        <label class="settings-checkbox">
            <input type="checkbox" @bind="loadPracticeSessions" @bind:after="SaveLoadPracticeSessionsAsync" disabled="@isBusy" />
            <span>@T["Settings.PracticeLabel"]</span>
        </label>
        <p class="settings-help">@T["Settings.PracticeHelp"]</p>
    </div>
</section>

<UpdateSettingsPanel />

<div class="settings-save-row">
    <div class="settings-feedback" role="status" aria-live="polite">@feedbackMessage</div>
</div>

<section class="dashboard-below-settings" aria-label="@T["Settings.BelowLabel"]">
    <DashboardOverview />
</section>

@code {
    private string resultsDirectory = string.Empty;
    private string selectedUserName = string.Empty;
    private string mergeFrom = string.Empty;
    private string mergeTo = string.Empty;
    private int mergeWarningCount;
    private bool watchOnStartup = true;
    private bool loadPracticeSessions;
    private bool isBusy;
    private bool isReloading;
    private ResultsDirectoryStatus? directoryStatus;
    private string? feedbackMessage;
    private IReadOnlyDictionary<DriverMerge, int> sharedSessionsByMerge = new Dictionary<DriverMerge, int>();

    protected override void OnInitialized()
    {
        base.OnInitialized();
        resultsDirectory = Configuration["LMU:ResultsDirectory"] ?? string.Empty;
        watchOnStartup = Configuration.GetValue("LMU:WatchResultsOnStartup", true);
        loadPracticeSessions = Configuration.GetValue("LMU:LoadPracticeSessions", false);
        directoryStatus = DashboardData.CheckResultsDirectory(resultsDirectory);
    }

    protected override void OnStateChanged()
    {
        selectedUserName = State.UserName ?? string.Empty;

        // Counted once per change rather than at each render of the merge list.
        sharedSessionsByMerge = State.DriverMerges.Distinct().ToDictionary(
            merge => merge,
            merge => DashboardData.CountSharedSessions(merge.From, merge.To));
    }

    private string GetDefaultDirectoryPlaceholder() =>
        DashboardData.Snapshot.ResultsDirectory
        ?? T["Settings.AutoDetect"];

    private void ValidateSelectedDirectory()
    {
        directoryStatus = DashboardData.CheckResultsDirectory(resultsDirectory);
        feedbackMessage = null;
    }

    private async Task BrowseForDirectoryAsync()
    {
        try
        {
            var selectedDirectory = await FolderPicker.PickFolderAsync(
                directoryStatus?.DirectoryPath ?? resultsDirectory);
            if (selectedDirectory is not null)
            {
                resultsDirectory = selectedDirectory;
                ValidateSelectedDirectory();
            }
        }
        catch (Exception exception) when (
            exception is IOException or UnauthorizedAccessException or PlatformNotSupportedException
                or System.Runtime.InteropServices.COMException)
        {
            feedbackMessage = T["Settings.PickerFailed", exception.Message];
        }
    }

    /// <summary>
    /// Validates, saves and loads the results directory in one step, so the folder in use is
    /// always the one stored in appsettings.json.
    /// </summary>
    private async Task ApplyResultsDirectoryAsync()
    {
        isBusy = true;
        isReloading = true;
        feedbackMessage = null;
        try
        {
            directoryStatus = DashboardData.CheckResultsDirectory(resultsDirectory);
            if (!directoryStatus.IsValid)
            {
                feedbackMessage = directoryStatus.ErrorMessage;
                return;
            }

            SettingsStore.SaveResultsDirectory(resultsDirectory.Trim());
            directoryStatus = await DashboardData.ReloadResultsAsync(resultsDirectory);
            feedbackMessage = directoryStatus.IsValid
                ? T["Settings.FolderSaved", directoryStatus.XmlFileCount]
                : directoryStatus.ErrorMessage;
        }
        catch (Exception exception) when (
            exception is IOException or UnauthorizedAccessException or System.Text.Json.JsonException)
        {
            feedbackMessage = T["Settings.FolderSaveFailed", exception.Message];
        }
        finally
        {
            isReloading = false;
            isBusy = false;
        }
    }

    private bool CanMerge() =>
        !string.IsNullOrWhiteSpace(mergeFrom)
        && !string.IsNullOrWhiteSpace(mergeTo)
        && !string.Equals(mergeFrom, mergeTo, StringComparison.OrdinalIgnoreCase);

    /// <summary>
    /// Warns when the two selected names drove in the same session: one person cannot.
    /// </summary>
    private void UpdateMergeWarning() =>
        mergeWarningCount = CanMerge() ? DashboardData.CountSharedSessions(mergeFrom, mergeTo) : 0;

    private void MergeDrivers()
    {
        try
        {
            DashboardData.SetDriverMerges(DriverMerges.Add(DashboardData.Snapshot.DriverMerges, mergeFrom, mergeTo));
            feedbackMessage = T["Settings.Merged", mergeFrom, mergeTo];
            mergeFrom = string.Empty;
            mergeTo = string.Empty;
            mergeWarningCount = 0;
        }
        catch (Exception exception) when (
            exception is IOException or UnauthorizedAccessException or ArgumentException
                or System.Text.Json.JsonException)
        {
            feedbackMessage = T["Settings.MergeFailed", exception.Message];
        }
    }

    private void CancelMerge(string from)
    {
        try
        {
            DashboardData.SetDriverMerges(DriverMerges.Remove(DashboardData.Snapshot.DriverMerges, from));
            feedbackMessage = T["Settings.MergeCancelled", from];
        }
        catch (Exception exception) when (
            exception is IOException or UnauthorizedAccessException or System.Text.Json.JsonException)
        {
            feedbackMessage = T["Settings.CancelMergeFailed", exception.Message];
        }
    }

    private void SaveSelectedUserName(ChangeEventArgs args)
    {
        if (args.Value is not string name || string.IsNullOrWhiteSpace(name))
        {
            return;
        }

        try
        {
            DashboardData.SelectUserName(name);
            feedbackMessage = T["Settings.DriverSaved", name];
        }
        catch (Exception exception) when (
            exception is IOException or UnauthorizedAccessException or ArgumentException
                or System.Text.Json.JsonException or InvalidOperationException)
        {
            selectedUserName = DashboardData.Snapshot.UserName ?? string.Empty;
            feedbackMessage = T["Settings.DriverSaveFailed", exception.Message];
        }
    }

    /// <summary>
    /// Saves the practice preference, then reloads the configured folder so practice sessions
    /// appear or disappear without restarting the application.
    /// </summary>
    private async Task SaveLoadPracticeSessionsAsync()
    {
        isBusy = true;
        feedbackMessage = null;
        try
        {
            SettingsStore.SaveLoadPracticeSessions(loadPracticeSessions);
            var status = await DashboardData.ReloadResultsAsync(Configuration["LMU:ResultsDirectory"]);
            feedbackMessage = status.IsValid
                ? loadPracticeSessions
                    ? T["Settings.PracticeLoaded"]
                    : T["Settings.PracticeRemoved"]
                : status.ErrorMessage;
        }
        catch (Exception exception) when (
            exception is IOException or UnauthorizedAccessException or System.Text.Json.JsonException)
        {
            feedbackMessage = T["Settings.PracticeSaveFailed", exception.Message];
        }
        finally
        {
            isBusy = false;
        }
    }

    private void SaveWatchOnStartup()
    {
        try
        {
            SettingsStore.SaveWatchOnStartup(watchOnStartup);
            feedbackMessage = T["Settings.StartupSaved"];
        }
        catch (Exception exception) when (
            exception is IOException or UnauthorizedAccessException or System.Text.Json.JsonException)
        {
            feedbackMessage = $"Impossible d’enregistrer la préférence de démarrage : {exception.Message}";
        }
    }
}
