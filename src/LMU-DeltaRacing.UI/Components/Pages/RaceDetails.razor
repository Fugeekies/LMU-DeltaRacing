@page "/race-details"
@inherits DashboardPage

<PageTitle>Détail des courses | LMU DeltaRacing</PageTitle>

<section class="page-heading">
    <div>
        <p class="eyebrow">ANALYSE DE SESSION</p>
        <h1>Détail des courses</h1>
        <p class="page-subtitle">Classement, meilleurs secteurs et écarts de la session sélectionnée, comparés au sein de chaque classe.</p>
    </div>
</section>

<ResultsGate State="State">
@if (events.Count == 0)
{
    <section class="panel empty-state">
        <span class="empty-icon" aria-hidden="true">○</span>
        <h3>Aucune session disponible</h3>
        <p>Les résultats détaillés apparaîtront ici lorsqu’une session aura été importée.</p>
    </section>
}
else
{
    var selectedEvent = GetSelectedEvent();
    var tabs = selectedEvent is null ? [] : GetTabs(selectedEvent);
    var activeTab = tabs.Contains(selectedTab) ? selectedTab : tabs.FirstOrDefault();
    var selectedSession = selectedEvent is null ? null : GetSession(selectedEvent, activeTab);
    RaceDetailsDriverResult[] results = selectedSession is null
        ? []
        : [.. RaceDetailsPresentation.CreateResults(selectedSession, State.UserName)];
    selectedRatedRace = selectedSession is null ? null : ratings.FindRace(selectedSession.Id);

    <section class="panel race-details-panel">
        <div class="race-details-toolbar">
            <label class="race-filter race-session-filter">
                <span>SÉLECTIONNER UNE COURSE</span>
                <select @bind="selectedEventId" aria-label="Sélectionner un événement">
                    @foreach (var raceEvent in events)
                    {
                        <option value="@raceEvent.Id">@FormatEventLabel(raceEvent)</option>
                    }
                </select>
            </label>
            @if (selectedEvent is not null)
            {
                <div class="session-meta">
                    <span>@selectedEvent.TrackVenue</span>
                    @if (!string.Equals(selectedEvent.TrackVenue, selectedEvent.TrackCourse, StringComparison.OrdinalIgnoreCase))
                    {
                        <span class="circuit-course">@selectedEvent.TrackCourse</span>
                    }
                </div>
            }
        </div>

        @* The race tab comes first: it is the result that counts. *@
        <div class="session-tabs" role="tablist" aria-label="Sessions de l'événement">
            @foreach (var tab in tabs)
            {
                <button type="button"
                        role="tab"
                        class="session-tab @(tab == activeTab ? "is-active" : string.Empty)"
                        aria-selected="@(tab == activeTab ? "true" : "false")"
                        @onclick="() => selectedTab = tab">
                    @GetTabLabel(tab, selectedEvent!)
                </button>
            }
        </div>

        @if (selectedRatedRace is { } ratedRace)
        {
            var playerChange = ratedRace.Find(State.UserName);
            <div class="rating-strip" aria-label="Cote pilote de la course">
                <span class="summary-label">FORCE DU PLATEAU</span>
                @foreach (var ratedClass in ratedRace.Classes)
                {
                    var category = CarCategory.FromCarClass(ratedClass.CarClass);
                    <span>
                        <span class="category-badge @CategoryStyle.CssClass(category)">@category</span>
                        <strong>@DisplayFormat.Rating(ratedClass.FieldStrength)</strong> (@ratedClass.Drivers.Count pilotes)
                    </span>
                }
                @if (playerChange is not null)
                {
                    <span>
                        Votre cote : <strong>@DisplayFormat.Rating(playerChange.Before) → @DisplayFormat.Rating(playerChange.After)</strong>
                        (@DisplayFormat.RatingChange(playerChange.Delta)), place attendue @DisplayFormat.Average(playerChange.ExpectedRank)
                    </span>
                }
                <a href="/rating">Cote pilote →</a>
            </div>
        }
        else if (selectedSession?.Kind == SessionKind.Race)
        {
            <div class="rating-strip">
                <span>Course non notée par la cote pilote : aucune classe n’a de pilote arrivé au drapeau à damier.</span>
            </div>
        }

        @if (results.Length == 0)
        {
            <div class="empty-state race-empty-state">
                <p>Cette session ne contient aucun résultat de pilote.</p>
            </div>
        }
        else
        {
            <div class="table-scroll race-details-scroll">
                <table class="data-table race-details-table">
                    <thead>
                        <tr>
                            @* Each cell stacks a value and its gap, so the grid fits without horizontal scrolling. *@
                            <th scope="col">POS <span class="th-sub">CLASSE</span></th>
                            <th scope="col">PILOTE <span class="th-sub">VOITURE</span></th>
                            <th scope="col" class="numeric-cell">SECTEUR 1 <span class="th-sub">ÉCART</span></th>
                            <th scope="col" class="numeric-cell">SECTEUR 2 <span class="th-sub">ÉCART</span></th>
                            <th scope="col" class="numeric-cell">SECTEUR 3 <span class="th-sub">ÉCART</span></th>
                            <th scope="col" class="numeric-cell">TOUR IDÉAL <span class="th-sub">ÉCART</span></th>
                            <th scope="col" class="numeric-cell">MEILLEUR TOUR <span class="th-sub">ÉCART</span></th>
                            <th scope="col" class="numeric-cell">TEMPS TOTAL <span class="th-sub">ÉCART</span></th>
                            <th scope="col" class="numeric-cell">CONTACTS <span class="th-sub">OBSTACLES</span></th>
                            <th scope="col" class="numeric-cell">LIMITES <span class="th-sub">TOURS INVALIDÉS</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (results.Length > VirtualizationThreshold)
                        {
                            <Virtualize Items="results" ItemContent="RenderRow" ItemSize="62" SpacerElement="tr" />
                        }
                        else
                        {
                            @foreach (var result in results)
                            {
                                @RenderRow(result)
                            }
                        }
                    </tbody>
                </table>
            </div>

            @* The story opens on the selected driver: it is the race they came to read. *@
            @if ((results.FirstOrDefault(result => result.Name == selectedDriver) ?? results.FirstOrDefault(result => result.IsPlayer)) is { } incidentsDriver)
            {
                var story = RaceStoryPresentation.Create(selectedSession!, incidentsDriver.Name);
                <section class="incident-panel" aria-label="Récit de la session du pilote">
                    <div class="incident-panel-heading">
                        <h3>@(story is null ? "Incidents" : "Déroulé de la course") de @incidentsDriver.Name</h3>
                        @if (selectedDriver is not null)
                        {
                            <button type="button" class="incident-close" @onclick="() => selectedDriver = null">Fermer</button>
                        }
                    </div>
                    @if (story is not null)
                    {
                        <RaceStoryChart Session="selectedSession!" Story="story" PlayerName="@State.UserName" OnSelectDriver="name => selectedDriver = results.FirstOrDefault(result => string.Equals(result.Name.Trim(), name, StringComparison.OrdinalIgnoreCase))?.Name ?? name" />
                    }
                    @if (incidentsDriver.Incidents.Count == 0)
                    {
                        <p class="incident-empty">Aucun incident dans cette session.</p>
                    }
                    else
                    {
                        <ol class="incident-list">
                            @* In a race, the story knows the lap of every incident; LMU only gives it for track limits. *@
                            @foreach (var (incident, lap) in story is null
                                ? incidentsDriver.Incidents.Select(incident => (incident, incident.Lap))
                                : story.Laps.SelectMany(lap => lap.Incidents.Select(incident => (incident, (int?)lap.Number))))
                            {
                                <li>
                                    <span class="incident-time">@DisplayFormat.TotalTime(incident.Elapsed)</span>
                                    <span class="incident-lap">@(lap is { } number ? $"Tour {number}" : string.Empty)</span>
                                    <span>@DrivingConductPresentation.Describe(incident)</span>
                                </li>
                            }
                        </ol>
                    }
                </section>
            }
        }

        <div class="sector-legend" aria-label="Légende des secteurs">
            <span><i class="sector-legend-swatch sector-class-best" aria-hidden="true"></i>Meilleur secteur de la classe</span>
            <span><i class="sector-legend-swatch sector-standard" aria-hidden="true"></i>Temps standard</span>
            <span>Secteurs : meilleur temps personnel sur les tours chronométrés · Écarts calculés par classe</span>
        </div>
    </section>
}

</ResultsGate>

@code {
    /// <summary>
    /// Grids larger than this are virtualized, as required by UI_DESIGN_SPEC.md. Smaller grids are
    /// rendered in full so they appear in the prerendered page without waiting for the browser.
    /// </summary>
    private const int VirtualizationThreshold = 40;

    private IReadOnlyList<RaceEvent> events = [];
    private DriverRatingHistory ratings = DriverRatings.Calculate([]);

    // Set while rendering, so that the rows, rendered by a fragment, find the ratings of the race shown.
    private RatedRace? selectedRatedRace;
    private string selectedEventId = string.Empty;
    private SessionTab selectedTab = SessionTab.Race;
    private string? selectedDriver;

    /// <summary>
    /// Gets or sets the event to open, as linked from the home dashboard (<c>?event=</c>).
    /// </summary>
    [SupplyParameterFromQuery(Name = "event")]
    public string? EventId { get; set; }

    /// <summary>
    /// The session tabs, in display order: the race first because it is the result that counts.
    /// </summary>
    private enum SessionTab
    {
        Race,
        Qualifying,
        Practice
    }

    protected override void OnParametersSet()
    {
        // A linked event opens on its race tab, the result the link refers to.
        if (!string.IsNullOrEmpty(EventId) && events.Any(raceEvent => raceEvent.Id == EventId))
        {
            selectedEventId = EventId;
            selectedTab = SessionTab.Race;
        }
    }

    protected override void OnStateChanged()
    {
        events = RaceEventPresentation.CreateEvents(State.Sessions, State.UserName);
        ratings = DriverRatings.Calculate(State.Sessions);

        if (events.All(raceEvent => raceEvent.Id != selectedEventId))
        {
            selectedEventId = events.FirstOrDefault()?.Id ?? string.Empty;
        }
    }

    private RaceEvent? GetSelectedEvent() =>
        events.FirstOrDefault(raceEvent => raceEvent.Id == selectedEventId);

    private static SessionTab[] GetTabs(RaceEvent raceEvent) =>
        [
            .. raceEvent.Race is null ? Array.Empty<SessionTab>() : [SessionTab.Race],
            .. raceEvent.Qualifying is null ? Array.Empty<SessionTab>() : [SessionTab.Qualifying],
            .. raceEvent.Practice is null ? Array.Empty<SessionTab>() : [SessionTab.Practice]
        ];

    private static Session? GetSession(RaceEvent raceEvent, SessionTab tab) =>
        tab switch
        {
            SessionTab.Race => raceEvent.Race,
            SessionTab.Qualifying => raceEvent.Qualifying,
            _ => raceEvent.Practice
        };

    private static string GetTabLabel(SessionTab tab, RaceEvent raceEvent) =>
        tab switch
        {
            SessionTab.Race => "COURSE",
            SessionTab.Qualifying => "QUALIFICATION",
            _ => raceEvent.PracticeSessionCount > 1 ? $"ESSAIS ({raceEvent.PracticeSessionCount} séances)" : "ESSAIS"
        };

    private string FormatEventLabel(RaceEvent raceEvent)
    {
        var carClass = raceEvent.Sessions
            .Select(session => DriverProfile.FindDriver(session, State.UserName)?.CarClass)
            .FirstOrDefault(value => !string.IsNullOrWhiteSpace(value));
        var sessionsLabel = string.Join(
            " · ",
            new[]
            {
                raceEvent.Practice is null ? null : "Essais",
                raceEvent.Qualifying is null ? null : "Qualif",
                raceEvent.Race is null ? null : "Course"
            }.OfType<string>());
        var label = $"{DisplayFormat.DateTime(raceEvent.StartedAt)} - {raceEvent.TrackVenue} ({sessionsLabel})";
        return string.IsNullOrWhiteSpace(carClass) ? label : $"{label} - {CarCategory.FromCarClass(carClass)}";
    }

    private RenderFragment<RaceDetailsDriverResult> RenderRow => result =>
        @<tr class="@(result.IsPlayer ? "player-row" : string.Empty)">
            <td class="stacked-cell">
                <span class="position-value">@(result.Position?.ToString("00") ?? "—")</span>
                <span class="cell-sub">
                    <span class="category-badge @CategoryStyle.CssClass(result.Category)">@result.Category</span>
                    <span class="class-position">@(result.ClassPosition is { } classPosition ? $"P{classPosition}" : "—")</span>
                </span>
            </td>
            <td class="stacked-cell race-driver-name">
                <span>
                    @result.Name
                    @if (result.IsPlayer)
                    {
                        <span class="player-tag">VOUS</span>
                    }
                    @if (selectedRatedRace?.Find(result.Name) is { } change)
                    {
                        <span class="driver-rating" title="@($"Cote avant la course : {DisplayFormat.Rating(change.Before)} → {DisplayFormat.Rating(change.After)} ({DisplayFormat.RatingChange(change.Delta)})")">@DisplayFormat.Rating(change.Before)</span>
                    }
                </span>
                <span class="cell-sub car-name">@result.Car</span>
            </td>
            @foreach (var sector in result.Sectors)
            {
                <td class="numeric-cell stacked-cell">
                    <span class="sector-time @GetSectorClass(sector)">@FormatSector(sector.Time)</span>
                    <span class="cell-sub delta-time @GetDeltaClass(sector.Delta)">@DisplayFormat.Delta(sector.Delta)</span>
                </td>
            }
            <td class="numeric-cell stacked-cell">
                <span class="lap-time">@DisplayFormat.Lap(result.IdealLap)</span>
                <span class="cell-sub delta-time @GetDeltaClass(result.DeltaToBestIdealLap)">@DisplayFormat.Delta(result.DeltaToBestIdealLap)</span>
            </td>
            <td class="numeric-cell stacked-cell">
                <span class="lap-time">@DisplayFormat.Lap(result.FastestLap)</span>
                <span class="cell-sub delta-time @GetDeltaClass(result.DeltaToBestLap)">@DisplayFormat.Delta(result.DeltaToBestLap)</span>
            </td>
            <td class="numeric-cell stacked-cell">
                <span class="lap-time">@DisplayFormat.TotalTime(result.TotalTime)</span>
                <span class="cell-sub leader-gap @GetLeaderGapClass(result.GapToLeader)">@FormatLeaderGap(result.GapToLeader)</span>
            </td>
            @if (result.Conduct is { } conduct)
            {
                <td class="numeric-cell stacked-cell">
                    @* A button in the row, not the row itself, so that the keyboard reaches it. *@
                    <button type="button"
                            class="conduct-button"
                            aria-label="Voir les incidents de @result.Name"
                            aria-expanded="@(IsFocused(result) ? "true" : "false")"
                            @onclick="() => ToggleIncidents(result.Name)">
                        <span>@conduct.VehicleContacts</span>
                        <span class="cell-sub">@conduct.ObstacleContacts</span>
                    </button>
                </td>
                <td class="numeric-cell stacked-cell">
                    <span>@conduct.Warnings</span>
                    <span class="cell-sub">@conduct.InvalidLaps</span>
                </td>
            }
            else
            {
                <td class="numeric-cell">—</td>
                <td class="numeric-cell">—</td>
            }
        </tr>;

    private bool IsFocused(RaceDetailsDriverResult result) =>
        selectedDriver == result.Name || (selectedDriver is null && result.IsPlayer);

    private void ToggleIncidents(string driverName) =>
        selectedDriver = selectedDriver == driverName ? null : driverName;

    private static string GetSectorClass(RaceDetailsSectorResult sector) =>
        sector.Performance == SectorPerformance.ClassBest ? "sector-class-best" : "sector-standard";

    private static string GetDeltaClass(TimeSpan? delta) =>
        delta switch
        {
            { } value when value > TimeSpan.Zero => "delta-loss",
            { } => "delta-best",
            _ => "delta-unavailable"
        };

    private static string FormatSector(TimeSpan? time) =>
        time is { } sectorTime
            ? $"{sectorTime.TotalSeconds.ToString("0.000", System.Globalization.CultureInfo.InvariantCulture)}s"
            : "—";

    /// <summary>
    /// Colours the gap like the other gaps: green for the leader, red when behind, muted when unknown.
    /// </summary>
    private static string GetLeaderGapClass(LeaderGap gap) =>
        gap.Kind switch
        {
            LeaderGapKind.Leader => "delta-best",
            LeaderGapKind.Time or LeaderGapKind.Laps or LeaderGapKind.Status => "delta-loss",
            _ => "delta-unavailable"
        };

    private static string FormatLeaderGap(LeaderGap gap) =>
        gap.Kind switch
        {
            LeaderGapKind.Leader => "LEADER",
            LeaderGapKind.Time => DisplayFormat.Delta(gap.Time),
            LeaderGapKind.Laps => gap.Laps == 1 ? "+1 tour" : $"+{gap.Laps} tours",
            LeaderGapKind.Status => gap.Status ?? "—",
            _ => "—"
        };
}
