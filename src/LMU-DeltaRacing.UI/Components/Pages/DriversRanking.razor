@page "/drivers-ranking"
@inherits DashboardPage

<PageTitle>Classement des coureurs | LMU DeltaRacing</PageTitle>

<section class="page-heading">
    <div>
        <p class="eyebrow">RIVALITÉ &amp; HISTORIQUE DES ADVERSAIRES</p>
        <h1>Classement des coureurs</h1>
        <p class="page-subtitle">Vos résultats face aux pilotes rencontrés dans les sessions importées.</p>
    </div>
</section>

<ResultsGate State="State">
@if (rivalries.Count == 0)
{
    <section class="panel empty-state">
        <span class="empty-icon" aria-hidden="true">○</span>
        <h3>Aucun affrontement disponible</h3>
        <p>Les confrontations apparaîtront lorsque des sessions importées contiendront un résultat classé pour vous et vos adversaires.</p>
    </section>
}
else
{
    var filteredRivalries = GetFilteredRivalries();
    <section class="panel ranking-panel">
        <div class="panel-heading">
            <div>
                <p class="eyebrow">HISTORIQUE HEAD-TO-HEAD</p>
                <h2>Adversaires rencontrés</h2>
            </div>
            <span class="count-badge">@filteredRivalries.Count</span>
        </div>

        <div class="ranking-filters">
            <label class="ranking-filter ranking-search">
                <span>RECHERCHER UN PILOTE</span>
                <input @bind="searchText"
                       @bind:event="oninput"
                       type="search"
                       placeholder="Nom du pilote…"
                       aria-label="Rechercher un pilote par nom" />
            </label>
            <label class="ranking-filter">
                <span>TRIER PAR</span>
                <select @bind="sortOrder" aria-label="Trier le classement">
                    <option value="sessions">Courses affrontées (décroissant)</option>
                    <option value="wins">Victoires (décroissant)</option>
                    <option value="percentage">% de victoire (décroissant)</option>
                    <option value="name">Nom (A à Z)</option>
                </select>
            </label>
        </div>

        @if (filteredRivalries.Count == 0)
        {
            <div class="empty-state race-empty-state">
                <p>Aucun pilote ne correspond à cette recherche.</p>
            </div>
        }
        else
        {
            <div class="table-scroll">
                <table class="data-table ranking-table">
                    <thead>
                        <tr>
                            <th scope="col">NOM DU PILOTE</th>
                            <th scope="col" class="numeric-cell">COURSES AFFRONTÉES</th>
                            <th scope="col" class="numeric-cell">VICTOIRES</th>
                            <th scope="col" class="numeric-cell">DÉFAITES</th>
                            <th scope="col" class="numeric-cell">% DE VICTOIRE</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var rivalry in filteredRivalries)
                        {
                            <tr>
                                <td class="ranking-driver">@rivalry.Name</td>
                                <td class="numeric-cell">@rivalry.SessionsFaced</td>
                                <td class="numeric-cell">@rivalry.Wins</td>
                                <td class="numeric-cell">@rivalry.Losses</td>
                                <td class="numeric-cell">
                                    <span class="win-rate">
                                        <span class="win-rate-bar" aria-hidden="true">
                                            <span class="win-rate-wins" style="width: @FormatShare(rivalry.Wins, rivalry.SessionsFaced)"></span>
                                            <span class="win-rate-losses" style="width: @FormatShare(rivalry.Losses, rivalry.SessionsFaced)"></span>
                                        </span>
                                        @rivalry.WinPercentage.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)%
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
}

</ResultsGate>

@code {
    private IReadOnlyList<DriverRivalry> rivalries = [];
    private string searchText = string.Empty;
    private string sortOrder = "sessions";

    protected override void OnStateChanged()
    {
        rivalries = DriversRankingPresentation.CreateRivalries(State.Sessions, State.UserName);
    }

    /// <summary>
    /// Formats a share of the faced races as a CSS width, with an invariant decimal separator.
    /// </summary>
    private static string FormatShare(int count, int total) =>
        string.Create(
            System.Globalization.CultureInfo.InvariantCulture,
            $"{(total == 0 ? 0 : count * 100d / total):0.##}%");

    private IReadOnlyList<DriverRivalry> GetFilteredRivalries()
    {
        var filtered = rivalries.Where(rivalry =>
            string.IsNullOrWhiteSpace(searchText)
            || rivalry.Name.Contains(searchText, StringComparison.OrdinalIgnoreCase));

        return sortOrder switch
        {
            "wins" => filtered.OrderByDescending(rivalry => rivalry.Wins)
                .ThenByDescending(rivalry => rivalry.SessionsFaced)
                .ThenBy(rivalry => rivalry.Name, StringComparer.OrdinalIgnoreCase)
                .ToArray(),
            "percentage" => filtered.OrderByDescending(rivalry => rivalry.WinPercentage)
                .ThenByDescending(rivalry => rivalry.SessionsFaced)
                .ThenBy(rivalry => rivalry.Name, StringComparer.OrdinalIgnoreCase)
                .ToArray(),
            "name" => filtered.OrderBy(rivalry => rivalry.Name, StringComparer.OrdinalIgnoreCase).ToArray(),
            _ => filtered.OrderByDescending(rivalry => rivalry.SessionsFaced)
                .ThenBy(rivalry => rivalry.Name, StringComparer.OrdinalIgnoreCase)
                .ToArray()
        };
    }
}
