@page "/drivers-ranking"
@inherits DashboardPage

<PageTitle>@T["PageTitle", T["Nav.DriversRanking"]]</PageTitle>

<section class="page-heading">
    <div>
        <p class="eyebrow">@T["DriversRanking.Eyebrow"]</p>
        <h1>@T["Nav.DriversRanking"]</h1>
        <p class="page-subtitle">@T["DriversRanking.Subtitle"]</p>
    </div>
</section>

<ResultsGate State="State">
@if (rivalries.Count == 0)
{
    <section class="panel empty-state">
        <span class="empty-icon" aria-hidden="true">○</span>
        <h3>@T["DriversRanking.EmptyTitle"]</h3>
        <p>@T["DriversRanking.EmptyText"]</p>
    </section>
}
else
{
    var filteredRivalries = GetFilteredRivalries();
    <section class="panel ranking-panel">
        <div class="panel-heading">
            <div>
                <p class="eyebrow">@T["DriversRanking.PanelEyebrow"]</p>
                <h2>@T["DriversRanking.PanelTitle"]</h2>
            </div>
            <span class="count-badge">@filteredRivalries.Count</span>
        </div>

        <div class="ranking-filters">
            <label class="ranking-filter ranking-search">
                <span>@T["DriversRanking.Search"]</span>
                <input @bind="searchText"
                       @bind:event="oninput"
                       type="search"
                       placeholder="@T["DriversRanking.SearchPlaceholder"]"
                       aria-label="@T["DriversRanking.SearchLabel"]" />
            </label>
            <label class="ranking-filter">
                <span>@T["DriversRanking.SortBy"]</span>
                <select @bind="sortOrder" aria-label="@T["DriversRanking.SortLabel"]">
                    <option value="sessions">@T["DriversRanking.SortSessions"]</option>
                    <option value="wins">@T["DriversRanking.SortWins"]</option>
                    <option value="percentage">@T["DriversRanking.SortPercentage"]</option>
                    <option value="name">@T["DriversRanking.SortName"]</option>
                </select>
            </label>
        </div>

        @if (filteredRivalries.Count == 0)
        {
            <div class="empty-state race-empty-state">
                <p>@T["DriversRanking.NoMatch"]</p>
            </div>
        }
        else
        {
            <div class="table-scroll">
                <table class="data-table ranking-table" data-resizable-columns>
                    <thead>
                        <tr>
                            <th scope="col">@T["DriversRanking.DriverName"]</th>
                            <th scope="col" class="numeric-cell">@T["DriverRating.Rating"]</th>
                            <th scope="col" class="numeric-cell">@T["DriversRanking.Faced"]</th>
                            <th scope="col" class="numeric-cell">@T["Home.Wins"]</th>
                            <th scope="col" class="numeric-cell">@T["DriversRanking.Losses"]</th>
                            <th scope="col" class="numeric-cell">@T["DriversRanking.WinRate"]</th>
                            <th scope="col" class="numeric-cell" title="@T["DriversRanking.AverageGapHint"]">@T["DriversRanking.AverageGap"]</th>
                            <th scope="col" class="numeric-cell" title="@T["DriversRanking.ContactsHint"]">@T["RaceDetails.Contacts"]</th>
                            <th scope="col">@T["Home.LastRace"] <span class="th-sub">@T["Common.Circuit"]</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var rivalry in filteredRivalries)
                        {
                            <tr>
                                <td class="ranking-driver">@rivalry.Name</td>
                                <td class="numeric-cell">@DisplayFormat.Rating(rivalry.Rating)</td>
                                <td class="numeric-cell">@rivalry.SessionsFaced</td>
                                <td class="numeric-cell">@rivalry.Wins</td>
                                <td class="numeric-cell">@rivalry.Losses</td>
                                <td class="numeric-cell">
                                    <span class="win-rate">
                                        <span class="win-rate-bar" aria-hidden="true">
                                            <span class="win-rate-wins" style="width: @FormatShare(rivalry.Wins, rivalry.SessionsFaced)"></span>
                                            <span class="win-rate-losses" style="width: @FormatShare(rivalry.Losses, rivalry.SessionsFaced)"></span>
                                        </span>
                                        @rivalry.WinPercentage.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)%
                                    </span>
                                </td>
                                <td class="numeric-cell delta-value @GapClass(rivalry.AverageClassGap)">@DisplayFormat.Signed(rivalry.AverageClassGap, "0.0")</td>
                                <td class="numeric-cell">@(rivalry.Contacts?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "—")</td>
                                <td class="stacked-cell">
                                    <span>@DisplayFormat.Day(rivalry.LastFacedAt)</span>
                                    <span class="cell-sub">@rivalry.LastFacedTrack</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
}

</ResultsGate>

@code {
    private IReadOnlyList<DriverRivalry> rivalries = [];
    private string searchText = string.Empty;
    private string sortOrder = "sessions";

    protected override void OnStateChanged()
    {
        rivalries = DriversRankingPresentation.CreateRivalries(State.Sessions, State.UserName, DriverRatings.Calculate(State.Sessions));
    }

    /// <summary>
    /// Colors an average gap: green when the player finishes ahead, red when behind.
    /// </summary>
    private static string GapClass(double gap) =>
        gap > 0 ? "delta-gain" : gap < 0 ? "delta-loss" : string.Empty;

    /// <summary>
    /// Formats a share of the faced races as a CSS width, with an invariant decimal separator.
    /// </summary>
    private static string FormatShare(int count, int total) =>
        string.Create(
            System.Globalization.CultureInfo.InvariantCulture,
            $"{(total == 0 ? 0 : count * 100d / total):0.##}%");

    private IReadOnlyList<DriverRivalry> GetFilteredRivalries()
    {
        var filtered = rivalries.Where(rivalry =>
            string.IsNullOrWhiteSpace(searchText)
            || rivalry.Name.Contains(searchText, StringComparison.OrdinalIgnoreCase));

        return sortOrder switch
        {
            "wins" => filtered.OrderByDescending(rivalry => rivalry.Wins)
                .ThenByDescending(rivalry => rivalry.SessionsFaced)
                .ThenBy(rivalry => rivalry.Name, StringComparer.OrdinalIgnoreCase)
                .ToArray(),
            "percentage" => filtered.OrderByDescending(rivalry => rivalry.WinPercentage)
                .ThenByDescending(rivalry => rivalry.SessionsFaced)
                .ThenBy(rivalry => rivalry.Name, StringComparer.OrdinalIgnoreCase)
                .ToArray(),
            "name" => filtered.OrderBy(rivalry => rivalry.Name, StringComparer.OrdinalIgnoreCase).ToArray(),
            _ => filtered.OrderByDescending(rivalry => rivalry.SessionsFaced)
                .ThenBy(rivalry => rivalry.Name, StringComparer.OrdinalIgnoreCase)
                .ToArray()
        };
    }
}
