@page "/"
@inherits DashboardPage

<PageTitle>@T["PageTitle", T["Nav.Home"]]</PageTitle>

<section class="page-heading">
    <div>
        <p class="eyebrow">@T["Home.Eyebrow"]</p>
        <h1>@T["Nav.Home"]</h1>
        <p class="page-subtitle">@T["Home.Subtitle"]</p>
    </div>
</section>

<ResultsGate State="State">
@if (dashboard.IsEmpty)
{
    <section class="panel empty-state">
        <span class="empty-icon" aria-hidden="true">○</span>
        <h3>@T["Home.EmptyTitle"]</h3>
        <p>@T["Home.EmptyText"]</p>
    </section>
}
else
{
    <div class="home-hero">
        <article class="home-tile home-driver" aria-labelledby="home-driver">
            <p id="home-driver" class="summary-label">@T["Home.Driver"]</p>
            <p class="home-driver-name">@State.UserName</p>
            @if (dashboard.FirstRaceAt is { } firstRaceAt && dashboard.LastRaceAt is { } lastRaceAt)
            {
                <p class="home-rate">@T["Home.OnTrackFromTo", DisplayFormat.Day(firstRaceAt), DisplayFormat.Day(lastRaceAt)]</p>
            }
            @if (rating is not null)
            {
                <a class="home-rating" href="/rating" aria-label="@T["Home.RatingLink"]">
                    <span class="summary-label">@(rating.IsProvisional ? T["Home.RatingProvisional"] : T["Home.Rating"])</span>
                    <strong>@DisplayFormat.Rating(rating.Rating)</strong>
                    @if (rating.Tier is { } tier)
                    {
                        <span class="tier-badge @TierStyle.CssClass(tier)">@DriverRatingPresentation.Label(tier).ToUpperInvariant()</span>
                    }
                    <span class="home-rate">
                        @(rating.Rank is { } rank ? $"{T["Home.RatingRank", DisplayFormat.Position(rank), rating.RankedDrivers]} · " : string.Empty)@T["Home.RatingRecentChange", DisplayFormat.RatingChange(rating.RecentChange), Texts.Plural("Common.Races", rating.RecentRaces)]
                    </span>
                </a>
            }
            <div class="home-favorites">
                @RenderFavorite(T["Home.FavoriteCircuit"], dashboard.FavoriteCircuit)
                @RenderFavorite(T["Home.FavoriteCar"], dashboard.FavoriteCar)
            </div>
        </article>

        <article class="home-tile home-form" aria-labelledby="home-form">
            <p id="home-form" class="summary-label">@T["Home.RecentForm"]</p>
            @if (dashboard.RecentForm.Count == 0)
            {
                <p class="home-value">—</p>
            }
            else
            {
                <ol class="form-pills" aria-label="@T["Home.RecentFormLabel"]">
                    @foreach (var entry in dashboard.RecentForm)
                    {
                        <li class="form-pill form-@entry.Kind.ToString().ToLowerInvariant()"
                            title="@($"{DisplayFormat.DateTime(entry.StartedAt)} · {entry.TrackVenue} · {entry.Category} · {entry.Car}")">
                            @entry.Label
                        </li>
                    }
                </ol>
            }
            @if (dashboard.LastRace is { } lastRace)
            {
                <div class="last-race">
                    <p class="summary-label">@T["Home.LastRace"]</p>
                    <p>
                        <strong>@DisplayFormat.DateTime(lastRace.StartedAt)</strong> · @lastRace.TrackVenue · @lastRace.Car
                    </p>
                    <p class="last-race-result">
                        @(lastRace.ClassPosition is { } position ? T["Home.ClassPosition", position].Value : T["Home.UnknownPosition"])
                        · @lastRace.StatusLabel
                        · @DisplayFormat.Lap(lastRace.BestLap)
                        @if (lastRace.EventId is { } eventId)
                        {
                            <a class="last-race-link" href="@($"/race-details?event={Uri.EscapeDataString(eventId)}")">@T["Home.SeeEvent"]</a>
                        }
                    </p>
                </div>
            }
        </article>
    </div>

    <section class="home-section" aria-labelledby="home-results">
        <h2 id="home-results" class="eyebrow">@T["Home.Record"]</h2>
        <div class="home-tiles">
            @RenderStat(T["Home.Races"], dashboard.Races, DisplayFormat.Count)
            @RenderStat(T["Home.Wins"], dashboard.Wins, DisplayFormat.Count)
            @RenderStat(T["Home.Podiums"], dashboard.Podiums, DisplayFormat.Count)
            @RenderStat(T["Home.Top5"], dashboard.Top5, DisplayFormat.Count)
            @RenderStat(T["Home.Top10"], dashboard.Top10, DisplayFormat.Count)
            @RenderStat(T["Home.AveragePosition"], dashboard.AveragePosition, DisplayFormat.Average, stacked: false)
        </div>
    </section>

    <section class="home-section" aria-labelledby="home-driving">
        <h2 id="home-driving" class="eyebrow">@T["Home.Mileage"]</h2>
        <div class="home-tiles">
            @RenderStat(T["Home.Laps"], dashboard.Laps, DisplayFormat.Count)
            @RenderStat(T["Home.Distance"], dashboard.DistanceKm, DisplayFormat.Distance)
            @RenderStat(T["Home.TimeOnTrack"], dashboard.TimeOnTrack, DisplayFormat.Duration)
        </div>
    </section>

    <section class="home-section" aria-labelledby="home-start">
        <h2 id="home-start" class="eyebrow">@T["Home.QualifyingStart"]</h2>
        <div class="home-tiles">
            @RenderStat(T["Home.Poles"], dashboard.Poles, DisplayFormat.Count)
            @RenderStat(T["Home.AverageQualifyingPosition"], dashboard.AverageQualifyingPosition, DisplayFormat.Average, stacked: false)
            <article class="home-tile">
                <h3 class="summary-label">@T["Home.PositionsGained"]</h3>
                <p class="home-value">
                    @RenderSigned(dashboard.AveragePositionsGained.Value, "0.0")
                    <span class="home-unit">@T["Home.PerRace"]</span>
                </p>
                @if (dashboard.TotalPositionsGained is { } total)
                {
                    <p class="home-rate">@RenderSigned(total, "0") @T["Home.InTotal"]</p>
                }
                @RenderBreakdown(dashboard.AveragePositionsGained, value => DisplayFormat.Signed(value, "0.0"), stacked: false)
            </article>
        </div>
    </section>

    <section class="home-section" aria-labelledby="home-retirements">
        <h2 id="home-retirements" class="eyebrow">@T["Home.Retirements"]</h2>
        <div class="home-tiles">
            @RenderStat(T["Home.Retirements"], dashboard.Retirements, DisplayFormat.Count)
            @RenderStat(T["Home.Disqualifications"], dashboard.Disqualifications, DisplayFormat.Count)
            @RenderStat(T["Home.Unclassified"], dashboard.Unclassified, DisplayFormat.Count)
            <article class="home-tile home-tile-wide">
                <h3 class="summary-label">@T["Home.RetirementCauses"]</h3>
                @if (dashboard.RetirementCauses.Count == 0)
                {
                    <p class="home-value">—</p>
                }
                else
                {
                    var causeSegments = HomeBarLayout.Create(dashboard.RetirementCauses.Select(cause =>
                        new HomeBarPart(cause.Label, cause.Share, cause.Count.ToString(System.Globalization.CultureInfo.InvariantCulture))));
                    <ul class="home-breakdown">
                        @foreach (var (cause, index) in dashboard.RetirementCauses.Select((cause, index) => (cause, index)))
                        {
                            @RenderBreakdownRow($"cause-{index % CauseColorCount}", cause.Label,
                                cause.Count.ToString(System.Globalization.CultureInfo.InvariantCulture), causeSegments[index], cause.Share)
                        }
                    </ul>
                }
            </article>
        </div>
    </section>
}

</ResultsGate>

@code {
    /// <summary>
    /// The number of distinct colors used for retirement causes before they repeat.
    /// </summary>
    private const int CauseColorCount = 5;

    private HomeDashboard dashboard = HomePresentation.Create([], null);
    private DriverRatingView? rating;

    protected override void OnStateChanged()
    {
        dashboard = HomePresentation.Create(State.Sessions, State.UserName);
        rating = DriverRatingPresentation.Create(State.Sessions, State.UserName);
    }

    private static bool ShowsBreakdown(HomeStat stat) =>
        stat.Value is > 0 or < 0 && stat.Categories.Count > 0;

    private static RenderFragment RenderStat(string label, HomeStat stat, Func<double?, string> format, bool stacked = true) =>
        @<article class="home-tile">
            <h3 class="summary-label">@label</h3>
            <p class="home-value">
                @format(stat.Value)
                @if (stat.Rate is { } rate)
                {
                    <span class="home-rate">@DisplayFormat.Percent(rate)</span>
                }
            </p>
            @RenderBreakdown(stat, format, stacked)
        </article>;

    /// <summary>
    /// Renders the breakdown by category: a stacked bar and its legend for a total, the legend alone
    /// for an average, whose parts do not add up to the total and so have no share to show on hover.
    /// </summary>
    private static RenderFragment RenderBreakdown(HomeStat stat, Func<double?, string> format, bool stacked) =>
        @<text>
            @if (ShowsBreakdown(stat))
            {
                var parts = stacked
                    ? stat.Categories.Where(part => part.Value > 0).ToArray()
                    : stat.Categories.Where(part => part.Value.HasValue).ToArray();
                IReadOnlyList<HomeBarSegment> segments = stacked
                    ? HomeBarLayout.Create(parts.Select(part =>
                        new HomeBarPart(part.Category, part.Value!.Value / stat.Value!.Value, format(part.Value))))
                    : [];
                <ul class="home-breakdown">
                    @foreach (var (part, index) in parts.Select((part, index) => (part, index)))
                    {
                        var colorClass = CategoryStyle.CssClass(part.Category);
                        @if (stacked)
                        {
                            @RenderBreakdownRow(colorClass, part.Category, format(part.Value), segments[index], part.Value!.Value / stat.Value!.Value)
                        }
                        else
                        {
                            @RenderBreakdownRow(colorClass, part.Category, format(part.Value), null, null)
                        }
                    }
                </ul>
            }
        </text>;

    private static RenderFragment RenderFavorite(string label, HomeFavorite? favorite) =>
        @<div class="home-favorite-item">
            <p class="summary-label">@label</p>
            @if (favorite is null)
            {
                <p class="home-favorite">—</p>
            }
            else
            {
                <p class="home-favorite">@favorite.Name</p>
                @if (favorite.Detail is { } detail)
                {
                    <p class="circuit-course">@detail</p>
                }
                <p class="home-rate">
                    @Texts.Plural("Common.Races", favorite.Races)
                    · @Texts.Plural("Common.Wins", favorite.Wins)
                    · @Texts.Plural("Common.Podiums", favorite.Podiums)
                </p>
            }
        </div>;

    private static RenderFragment RenderSigned(double? value, string format) =>
        @<span class="@(value > 0 ? "delta-gain" : value < 0 ? "delta-loss" : string.Empty)">@DisplayFormat.Signed(value, format)</span>;

    /// <summary>
    /// Renders one line of a breakdown: its color, label and value, then for a share of a total its
    /// percentage and a gauge of that share. An average has no share: the line stops at its value.
    /// </summary>
    private static RenderFragment RenderBreakdownRow(string colorClass, string label, string value, HomeBarSegment? segment, double? share) =>
        @<li class="home-breakdown-row" style="@(segment is null ? null : $"--share: {segment.Width}")" title="@segment?.Tooltip">
            <span class="home-breakdown-label"><i class="home-breakdown-dot @colorClass" aria-hidden="true"></i>@label</span>
            <span class="home-breakdown-value">
                @value
                @if (share is { } part)
                {
                    <span class="home-breakdown-share">@DisplayFormat.Percent(part)</span>
                }
            </span>
            @if (segment is not null)
            {
                <span class="home-breakdown-track" aria-hidden="true"><span class="home-breakdown-fill @colorClass"></span></span>
            }
        </li>;
}
