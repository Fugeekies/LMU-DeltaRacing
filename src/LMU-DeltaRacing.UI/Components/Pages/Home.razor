@page "/"
@inherits DashboardPage

<PageTitle>Accueil | LMU DeltaRacing</PageTitle>

<section class="page-heading">
    <div>
        <p class="eyebrow">TABLEAU DE BORD</p>
        <h1>Accueil</h1>
        <p class="page-subtitle">Votre carrière en un coup d’œil, résultats comptés sur la position en classe.</p>
    </div>
</section>

<ResultsGate State="State">
@if (dashboard.IsEmpty)
{
    <section class="panel empty-state">
        <span class="empty-icon" aria-hidden="true">○</span>
        <h3>Aucune course disponible</h3>
        <p>Les sessions de qualification et de course du pilote sélectionné apparaîtront ici après leur import.</p>
    </section>
}
else
{
    <div class="home-hero">
        <article class="home-tile home-driver" aria-labelledby="home-driver">
            <p id="home-driver" class="summary-label">PILOTE</p>
            <p class="home-driver-name">@State.UserName</p>
            @if (dashboard.FirstRaceAt is { } firstRaceAt && dashboard.LastRaceAt is { } lastRaceAt)
            {
                <p class="home-rate">En piste du @DisplayFormat.Day(firstRaceAt) au @DisplayFormat.Day(lastRaceAt)</p>
            }
            <div class="home-favorites">
                @RenderFavorite("CIRCUIT FAVORI", dashboard.FavoriteCircuit)
                @RenderFavorite("VOITURE FAVORITE", dashboard.FavoriteCar)
            </div>
        </article>

        <article class="home-tile home-form" aria-labelledby="home-form">
            <p id="home-form" class="summary-label">FORME RÉCENTE</p>
            @if (dashboard.RecentForm.Count == 0)
            {
                <p class="home-value">—</p>
            }
            else
            {
                <ol class="form-pills" aria-label="Dernières courses, de la plus récente à la plus ancienne">
                    @foreach (var entry in dashboard.RecentForm)
                    {
                        <li class="form-pill form-@entry.Kind.ToString().ToLowerInvariant()"
                            title="@($"{DisplayFormat.DateTime(entry.StartedAt)} · {entry.TrackVenue} · {entry.Category} · {entry.Car}")">
                            @entry.Label
                        </li>
                    }
                </ol>
            }
            @if (dashboard.LastRace is { } lastRace)
            {
                <div class="last-race">
                    <p class="summary-label">DERNIÈRE COURSE</p>
                    <p>
                        <strong>@DisplayFormat.DateTime(lastRace.StartedAt)</strong> · @lastRace.TrackVenue · @lastRace.Car
                    </p>
                    <p class="last-race-result">
                        @(lastRace.ClassPosition is { } position ? $"P{position} en classe" : "Position inconnue")
                        · @lastRace.StatusLabel
                        · @DisplayFormat.Lap(lastRace.BestLap)
                        @if (lastRace.EventId is { } eventId)
                        {
                            <a class="last-race-link" href="@($"/race-details?event={Uri.EscapeDataString(eventId)}")">Voir l’événement →</a>
                        }
                    </p>
                </div>
            }
        </article>
    </div>

    <section class="home-section" aria-labelledby="home-results">
        <h2 id="home-results" class="eyebrow">PALMARÈS</h2>
        <div class="home-tiles">
            @RenderStat("COURSES", dashboard.Races, DisplayFormat.Count)
            @RenderStat("VICTOIRES", dashboard.Wins, DisplayFormat.Count)
            @RenderStat("PODIUMS", dashboard.Podiums, DisplayFormat.Count)
            @RenderStat("TOP 5", dashboard.Top5, DisplayFormat.Count)
            @RenderStat("TOP 10", dashboard.Top10, DisplayFormat.Count)
            @RenderStat("POSITION MOYENNE", dashboard.AveragePosition, DisplayFormat.Average, stacked: false)
        </div>
    </section>

    <section class="home-section" aria-labelledby="home-driving">
        <h2 id="home-driving" class="eyebrow">ROULAGE</h2>
        <div class="home-tiles">
            @RenderStat("TOURS BOUCLÉS", dashboard.Laps, DisplayFormat.Count)
            @RenderStat("DISTANCE", dashboard.DistanceKm, DisplayFormat.Distance)
            @RenderStat("TEMPS EN PISTE", dashboard.TimeOnTrack, DisplayFormat.Duration)
        </div>
    </section>

    <section class="home-section" aria-labelledby="home-start">
        <h2 id="home-start" class="eyebrow">QUALIFICATION &amp; DÉPART</h2>
        <div class="home-tiles">
            @RenderStat("POLES", dashboard.Poles, DisplayFormat.Count)
            @RenderStat("POSITION MOYENNE EN QUALIF", dashboard.AverageQualifyingPosition, DisplayFormat.Average, stacked: false)
            <article class="home-tile">
                <h3 class="summary-label">PLACES GAGNÉES</h3>
                <p class="home-value">
                    @RenderSigned(dashboard.AveragePositionsGained.Value, "0.0")
                    <span class="home-unit">/ course</span>
                </p>
                @if (dashboard.TotalPositionsGained is { } total)
                {
                    <p class="home-rate">@RenderSigned(total, "0") au total</p>
                }
                @RenderBreakdown(dashboard.AveragePositionsGained, value => DisplayFormat.Signed(value, "0.0"), stacked: false)
            </article>
        </div>
    </section>

    <section class="home-section" aria-labelledby="home-retirements">
        <h2 id="home-retirements" class="eyebrow">ABANDONS</h2>
        <div class="home-tiles">
            @RenderStat("ABANDONS", dashboard.Retirements, DisplayFormat.Count)
            @RenderStat("DISQUALIFICATIONS", dashboard.Disqualifications, DisplayFormat.Count)
            @RenderStat("NON CLASSÉ", dashboard.Unclassified, DisplayFormat.Count)
            <article class="home-tile home-tile-wide">
                <h3 class="summary-label">CAUSES D’ABANDON</h3>
                @if (dashboard.RetirementCauses.Count == 0)
                {
                    <p class="home-value">—</p>
                }
                else
                {
                    <div class="home-bar" aria-hidden="true">
                        @foreach (var (cause, index) in dashboard.RetirementCauses.Select((cause, index) => (cause, index)))
                        {
                            <span class="home-bar-part cause-@(index % CauseColorCount)" style="width: @FormatPercentWidth(cause.Share)"></span>
                        }
                    </div>
                    <ul class="home-share-list">
                        @foreach (var (cause, index) in dashboard.RetirementCauses.Select((cause, index) => (cause, index)))
                        {
                            <li>
                                <i class="home-swatch cause-@(index % CauseColorCount)" aria-hidden="true"></i>
                                @cause.Label <strong>@cause.Count</strong> <span>(@DisplayFormat.Percent(cause.Share))</span>
                            </li>
                        }
                    </ul>
                }
            </article>
        </div>
    </section>
}

</ResultsGate>

@code {
    /// <summary>
    /// The number of distinct colors used for retirement causes before they repeat.
    /// </summary>
    private const int CauseColorCount = 5;

    private HomeDashboard dashboard = HomePresentation.Create([], null);

    protected override void OnStateChanged()
    {
        dashboard = HomePresentation.Create(State.Sessions, State.UserName);
    }

    private static bool ShowsBreakdown(HomeStat stat) =>
        stat.Value is > 0 or < 0 && stat.Categories.Count > 0;

    private static RenderFragment RenderStat(string label, HomeStat stat, Func<double?, string> format, bool stacked = true) =>
        @<article class="home-tile">
            <h3 class="summary-label">@label</h3>
            <p class="home-value">
                @format(stat.Value)
                @if (stat.Rate is { } rate)
                {
                    <span class="home-rate">@DisplayFormat.Percent(rate)</span>
                }
            </p>
            @RenderBreakdown(stat, format, stacked)
        </article>;

    /// <summary>
    /// Renders the breakdown by category: a stacked bar and its legend for a total, the legend alone
    /// for an average, whose parts do not add up to the total.
    /// </summary>
    private static RenderFragment RenderBreakdown(HomeStat stat, Func<double?, string> format, bool stacked) =>
        @<text>
            @if (ShowsBreakdown(stat))
            {
                var parts = stacked
                    ? stat.Categories.Where(part => part.Value > 0).ToArray()
                    : stat.Categories.Where(part => part.Value.HasValue).ToArray();
                @if (stacked)
                {
                    <div class="home-bar home-bar-thin" aria-hidden="true">
                        @foreach (var part in parts)
                        {
                            <span class="home-bar-part @GetCategoryClass(part.Category)" style="width: @FormatPercentWidth(part.Value!.Value / stat.Value!.Value)"></span>
                        }
                    </div>
                }
                <ul class="home-share-list home-breakdown-legend">
                    @foreach (var part in parts)
                    {
                        <li>
                            <i class="home-swatch @GetCategoryClass(part.Category)" aria-hidden="true"></i>
                            @part.Category <strong>@format(part.Value)</strong>
                        </li>
                    }
                </ul>
            }
        </text>;

    private static RenderFragment RenderFavorite(string label, HomeFavorite? favorite) =>
        @<div class="home-favorite-item">
            <p class="summary-label">@label</p>
            @if (favorite is null)
            {
                <p class="home-favorite">—</p>
            }
            else
            {
                <p class="home-favorite">@favorite.Name</p>
                @if (favorite.Detail is { } detail)
                {
                    <p class="circuit-course">@detail</p>
                }
                <p class="home-rate">
                    @favorite.Races @(favorite.Races > 1 ? "courses" : "course")
                    · @favorite.Wins @(favorite.Wins > 1 ? "victoires" : "victoire")
                    · @favorite.Podiums @(favorite.Podiums > 1 ? "podiums" : "podium")
                </p>
            }
        </div>;

    private static RenderFragment RenderSigned(double? value, string format) =>
        @<span class="@(value > 0 ? "delta-gain" : value < 0 ? "delta-loss" : string.Empty)">@DisplayFormat.Signed(value, format)</span>;

    private static string FormatPercentWidth(double share) =>
        $"{(share * 100).ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)}%";

    private static string GetCategoryClass(string category) =>
        CarCategory.Known.Contains(category) ? $"category-{category.ToLowerInvariant()}" : "category-other";
}
