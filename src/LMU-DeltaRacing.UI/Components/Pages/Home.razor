@page "/"
@implements IDisposable
@inject DashboardDataService DashboardData

<PageTitle>Accueil | LMU DeltaRacing</PageTitle>

<section class="page-heading">
    <div>
        <p class="eyebrow">TABLEAU DE BORD</p>
        <h1>Accueil</h1>
        <p class="page-subtitle">Votre carrière en un coup d’œil, résultats comptés sur la position en classe.</p>
    </div>
</section>

@if (state.IsLoading && state.Sessions.Count == 0)
{
    <section class="panel empty-state" aria-live="polite">
        <span class="loading-spinner" aria-hidden="true"></span>
        <p>Chargement de l’historique des courses…</p>
    </section>
}
else if (!string.IsNullOrWhiteSpace(state.ErrorMessage) && state.Sessions.Count == 0)
{
    <section class="notice notice-error" role="alert">
        <span class="notice-symbol" aria-hidden="true">!</span>
        <div>
            <h2>Les résultats n’ont pas pu être chargés</h2>
            <p>@state.ErrorMessage</p>
            <p>Vérifiez le dossier configuré dans <a href="/settings">Options</a>.</p>
        </div>
    </section>
}
else if (dashboard.IsEmpty)
{
    <section class="panel empty-state">
        <span class="empty-icon" aria-hidden="true">○</span>
        <h3>Aucune course disponible</h3>
        <p>Les sessions de qualification et de course du pilote sélectionné apparaîtront ici après leur import.</p>
    </section>
}
else
{
    <div class="home-hero">
        <article class="home-tile home-driver" aria-labelledby="home-driver">
            <p id="home-driver" class="summary-label">PILOTE</p>
            <p class="home-driver-name">@state.UserName</p>
            @if (dashboard.FirstRaceAt is { } firstRaceAt && dashboard.LastRaceAt is { } lastRaceAt)
            {
                <p class="home-rate">En piste du @FormatDay(firstRaceAt) au @FormatDay(lastRaceAt)</p>
            }
            <div class="home-favorites">
                @RenderFavorite("CIRCUIT FAVORI", dashboard.FavoriteCircuit)
                @RenderFavorite("VOITURE FAVORITE", dashboard.FavoriteCar)
            </div>
        </article>

        <article class="home-tile home-form" aria-labelledby="home-form">
            <p id="home-form" class="summary-label">FORME RÉCENTE</p>
            @if (dashboard.RecentForm.Count == 0)
            {
                <p class="home-value">—</p>
            }
            else
            {
                <ol class="form-pills" aria-label="Dernières courses, de la plus récente à la plus ancienne">
                    @foreach (var entry in dashboard.RecentForm)
                    {
                        <li class="form-pill form-@entry.Kind.ToString().ToLowerInvariant()"
                            title="@($"{FormatDate(entry.StartedAt)} · {entry.TrackVenue} · {entry.Category} · {entry.Car}")">
                            @entry.Label
                        </li>
                    }
                </ol>
            }
            @if (dashboard.LastRace is { } lastRace)
            {
                <div class="last-race">
                    <p class="summary-label">DERNIÈRE COURSE</p>
                    <p>
                        <strong>@FormatDate(lastRace.StartedAt)</strong> · @lastRace.TrackVenue · @lastRace.Car
                    </p>
                    <p class="last-race-result">
                        @(lastRace.ClassPosition is { } position ? $"P{position} en classe" : "Position inconnue")
                        · @lastRace.StatusLabel
                        · @FormatLap(lastRace.BestLap)
                        @if (lastRace.EventId is { } eventId)
                        {
                            <a class="last-race-link" href="@($"/race-details?event={Uri.EscapeDataString(eventId)}")">Voir l’événement →</a>
                        }
                    </p>
                </div>
            }
        </article>
    </div>

    <section class="home-section" aria-labelledby="home-results">
        <h2 id="home-results" class="eyebrow">PALMARÈS</h2>
        <div class="home-tiles">
            @RenderStat("COURSES", dashboard.Races, FormatCount)
            @RenderStat("VICTOIRES", dashboard.Wins, FormatCount)
            @RenderStat("PODIUMS", dashboard.Podiums, FormatCount)
            @RenderStat("TOP 5", dashboard.Top5, FormatCount)
            @RenderStat("TOP 10", dashboard.Top10, FormatCount)
            @RenderStat("POSITION MOYENNE", dashboard.AveragePosition, FormatAverage)
            <article class="home-tile home-tile-wide">
                <h3 class="summary-label">RÉPARTITION PAR CATÉGORIE</h3>
                @if (dashboard.CategoryShares.Count == 0)
                {
                    <p class="home-value">—</p>
                }
                else
                {
                    <div class="home-bar" aria-hidden="true">
                        @foreach (var share in dashboard.CategoryShares)
                        {
                            <span class="home-bar-part @GetCategoryClass(share.Label)" style="width: @FormatPercentWidth(share.Share)"></span>
                        }
                    </div>
                    <ul class="home-share-list">
                        @foreach (var share in dashboard.CategoryShares)
                        {
                            <li>
                                <i class="home-swatch @GetCategoryClass(share.Label)" aria-hidden="true"></i>
                                @share.Label <strong>@FormatPercent(share.Share)</strong> <span>(@share.Count)</span>
                            </li>
                        }
                    </ul>
                }
            </article>
        </div>
    </section>

    <section class="home-section" aria-labelledby="home-driving">
        <h2 id="home-driving" class="eyebrow">ROULAGE</h2>
        <div class="home-tiles">
            @RenderStat("TOURS BOUCLÉS", dashboard.Laps, FormatCount)
            @RenderStat("DISTANCE", dashboard.DistanceKm, FormatDistance)
            @RenderStat("TEMPS EN PISTE", dashboard.TimeOnTrack, FormatDuration)
        </div>
    </section>

    <section class="home-section" aria-labelledby="home-start">
        <h2 id="home-start" class="eyebrow">QUALIFICATION &amp; DÉPART</h2>
        <div class="home-tiles">
            @RenderStat("POLES", dashboard.Poles, FormatCount)
            @RenderStat("POSITION MOYENNE EN QUALIF", dashboard.AverageQualifyingPosition, FormatAverage)
            <article class="home-tile">
                <h3 class="summary-label">PLACES GAGNÉES</h3>
                <p class="home-value">
                    @RenderSigned(dashboard.AveragePositionsGained.Value, "0.0")
                    <span class="home-unit">/ course</span>
                </p>
                @if (dashboard.TotalPositionsGained is { } total)
                {
                    <p class="home-rate">@RenderSigned(total, "0") au total</p>
                }
                @RenderBreakdown(dashboard.AveragePositionsGained, value => FormatSigned(value, "0.0"))
            </article>
        </div>
    </section>

    <section class="home-section" aria-labelledby="home-retirements">
        <h2 id="home-retirements" class="eyebrow">ABANDONS</h2>
        <div class="home-tiles">
            @RenderStat("ABANDONS", dashboard.Retirements, FormatCount)
            @RenderStat("DISQUALIFICATIONS", dashboard.Disqualifications, FormatCount)
            @RenderStat("NON CLASSÉ", dashboard.Unclassified, FormatCount)
            <article class="home-tile home-tile-wide">
                <h3 class="summary-label">CAUSES D’ABANDON</h3>
                @if (dashboard.RetirementCauses.Count == 0)
                {
                    <p class="home-value">—</p>
                }
                else
                {
                    <div class="home-bar" aria-hidden="true">
                        @foreach (var (cause, index) in dashboard.RetirementCauses.Select((cause, index) => (cause, index)))
                        {
                            <span class="home-bar-part cause-@(index % CauseColorCount)" style="width: @FormatPercentWidth(cause.Share)"></span>
                        }
                    </div>
                    <ul class="home-share-list">
                        @foreach (var (cause, index) in dashboard.RetirementCauses.Select((cause, index) => (cause, index)))
                        {
                            <li>
                                <i class="home-swatch cause-@(index % CauseColorCount)" aria-hidden="true"></i>
                                @cause.Label <strong>@cause.Count</strong> <span>(@FormatPercent(cause.Share))</span>
                            </li>
                        }
                    </ul>
                }
            </article>
        </div>
    </section>
}

@code {
    /// <summary>
    /// The number of distinct colors used for retirement causes before they repeat.
    /// </summary>
    private const int CauseColorCount = 5;

    private static readonly System.Globalization.NumberFormatInfo NumberFormat = new()
    {
        NumberDecimalSeparator = ".",
        NumberGroupSeparator = " "
    };

    private DashboardState state = new(true, 0, 0, false, null, [], [], null);
    private HomeDashboard dashboard = HomePresentation.Create([], null);

    protected override void OnInitialized()
    {
        DashboardData.StateChanged += OnDashboardStateChanged;
        UpdateState();
    }

    public void Dispose() => DashboardData.StateChanged -= OnDashboardStateChanged;

    private void OnDashboardStateChanged() =>
        _ = InvokeAsync(() =>
        {
            UpdateState();
            StateHasChanged();
        });

    private void UpdateState()
    {
        state = DashboardData.Snapshot;
        dashboard = HomePresentation.Create(state.Sessions, state.UserName);
    }

    private static bool ShowsBreakdown(HomeStat stat) =>
        stat.Value is > 0 or < 0 && stat.Categories.Count > 0;

    private RenderFragment RenderStat(string label, HomeStat stat, Func<double?, string> format) =>
        @<article class="home-tile">
            <h3 class="summary-label">@label</h3>
            <p class="home-value">
                @format(stat.Value)
                @if (stat.Rate is { } rate)
                {
                    <span class="home-rate">@FormatPercent(rate)</span>
                }
            </p>
            @RenderBreakdown(stat, format)
        </article>;

    private RenderFragment RenderBreakdown(HomeStat stat, Func<double?, string> format) =>
        @<text>
            @if (ShowsBreakdown(stat))
            {
                <ul class="home-breakdown">
                    @foreach (var category in stat.Categories)
                    {
                        <li>
                            <span class="category-badge">@category.Category</span>
                            <span>@format(category.Value)</span>
                        </li>
                    }
                </ul>
            }
        </text>;

    private static RenderFragment RenderFavorite(string label, HomeFavorite? favorite) =>
        @<div class="home-favorite-item">
            <p class="summary-label">@label</p>
            @if (favorite is null)
            {
                <p class="home-favorite">—</p>
            }
            else
            {
                <p class="home-favorite">@favorite.Name</p>
                @if (favorite.Detail is { } detail)
                {
                    <p class="circuit-course">@detail</p>
                }
                <p class="home-rate">
                    @favorite.Races @(favorite.Races > 1 ? "courses" : "course")
                    · @favorite.Wins @(favorite.Wins > 1 ? "victoires" : "victoire")
                    · @favorite.Podiums @(favorite.Podiums > 1 ? "podiums" : "podium")
                </p>
            }
        </div>;

    private static RenderFragment RenderSigned(double? value, string format) =>
        @<span class="@(value > 0 ? "delta-gain" : value < 0 ? "delta-loss" : string.Empty)">@FormatSigned(value, format)</span>;

    private static string FormatCount(double? value) =>
        value?.ToString("#,0", NumberFormat) ?? "—";

    private static string FormatAverage(double? value) =>
        value?.ToString("0.0", NumberFormat) ?? "—";

    private static string FormatSigned(double? value, string format) =>
        value is { } number
            ? (number > 0 ? "+" : string.Empty) + number.ToString(format, NumberFormat).Replace("-", "−", StringComparison.Ordinal)
            : "—";

    private static string FormatDistance(double? kilometers) =>
        kilometers is { } value ? $"{value.ToString("#,0", NumberFormat)} km" : "—";

    private static string FormatDuration(double? seconds)
    {
        if (seconds is not { } value)
        {
            return "—";
        }

        var duration = TimeSpan.FromSeconds(value);
        return $"{(int)duration.TotalHours}:{duration.Minutes:00}";
    }

    private static string FormatPercent(double share) =>
        $"{(share * 100).ToString("0.0", NumberFormat)} %";

    private static string FormatPercentWidth(double share) =>
        $"{(share * 100).ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)}%";

    private static string FormatDate(DateTimeOffset date) =>
        date.ToLocalTime().ToString("dd/MM/yyyy HH:mm", System.Globalization.CultureInfo.InvariantCulture);

    private static string FormatDay(DateTimeOffset date) =>
        date.ToLocalTime().ToString("dd/MM/yyyy", System.Globalization.CultureInfo.InvariantCulture);

    private static string FormatLap(TimeSpan? time) =>
        time?.ToString(@"m\:ss\.fff", System.Globalization.CultureInfo.InvariantCulture) ?? "—";

    private static string GetCategoryClass(string category) =>
        CarCategory.Known.Contains(category) ? $"category-{category.ToLowerInvariant()}" : "category-other";
}
