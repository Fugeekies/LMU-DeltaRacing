@page "/my-races"
@implements IDisposable
@inject DashboardDataService DashboardData

<PageTitle>Mes courses | LMU DeltaRacing</PageTitle>

<section class="page-heading">
    <div>
        <p class="eyebrow">HISTORIQUE &amp; PROGRESSION</p>
        <h1>Mes courses</h1>
        <p class="page-subtitle">Vos meilleurs temps, comparés à la session précédente sur le même circuit et dans la même catégorie.</p>
    </div>
</section>

@if (state.IsLoading && state.Sessions.Count == 0)
{
    <section class="panel empty-state" aria-live="polite">
        <span class="loading-spinner" aria-hidden="true"></span>
        <p>Chargement de l’historique des courses…</p>
    </section>
}
else if (!string.IsNullOrWhiteSpace(state.ErrorMessage) && state.Sessions.Count == 0)
{
    <section class="notice notice-error" role="alert">
        <span class="notice-symbol" aria-hidden="true">!</span>
        <div>
            <h2>Les résultats n’ont pas pu être chargés</h2>
            <p>@state.ErrorMessage</p>
            <p>Vérifiez le dossier configuré dans <a href="/settings">Options</a>.</p>
        </div>
    </section>
}
else if (records.Count == 0)
{
    <section class="panel empty-state">
        <span class="empty-icon" aria-hidden="true">○</span>
        <h3>Aucune course disponible</h3>
        <p>Les sessions de qualification et de course du pilote sélectionné apparaîtront ici après leur import.</p>
    </section>
}
else
{
    var filteredRecords = GetFilteredRecords();
    <section class="panel race-history">
        <div class="panel-heading race-history-heading">
            <div>
                <p class="eyebrow">PERFORMANCES ENREGISTRÉES</p>
                <h2>Progression par circuit</h2>
            </div>
            <span class="count-badge">@filteredRecords.Count</span>
        </div>

        <div class="race-filters" aria-label="Filtres des courses">
            <label class="race-filter">
                <span>CIRCUIT</span>
                <select @bind="selectedTrack" aria-label="Filtrer par circuit">
                    <option value="">Tous les circuits</option>
                    @foreach (var track in tracks)
                    {
                        <option value="@track">@track</option>
                    }
                </select>
            </label>
            <label class="race-filter">
                <span>CATÉGORIE</span>
                <select @bind="selectedCategory" aria-label="Filtrer par catégorie">
                    <option value="">Toutes les catégories</option>
                    @foreach (var category in categories)
                    {
                        <option value="@category">@category</option>
                    }
                </select>
            </label>
        </div>

        @if (filteredRecords.Count == 0)
        {
            <div class="empty-state race-empty-state">
                <p>Aucune course ne correspond à ces filtres.</p>
            </div>
        }
        else
        {
            @foreach (var circuit in filteredRecords
                .GroupBy(record => new { record.TrackVenue, record.TrackCourse })
                .OrderBy(group => group.Key.TrackVenue))
            {
                <section class="circuit-history" aria-label="@($"Historique de {circuit.Key.TrackVenue}")">
                    <div class="circuit-heading">
                        <div>
                            <span class="eyebrow">CIRCUIT</span>
                            <h3>@circuit.Key.TrackVenue</h3>
                            @if (!string.Equals(circuit.Key.TrackVenue, circuit.Key.TrackCourse, StringComparison.OrdinalIgnoreCase))
                            {
                                <span class="circuit-course">@circuit.Key.TrackCourse</span>
                            }
                        </div>
                        <div class="circuit-actions">
                            <a class="progression-link"
                               href="@GetProgressionLink(circuit.Key.TrackVenue, circuit.Key.TrackCourse)"
                               aria-label="Voir la progression sur ce circuit"
                               title="Voir la progression sur ce circuit">📈</a>
                            <span class="count-badge">@circuit.Count() résultats</span>
                        </div>
                    </div>
                    <div class="table-scroll">
                        <table class="data-table races-table">
                            <thead>
                                <tr>
                                    <th scope="col">DATE / HEURE</th>
                                    <th scope="col">CATÉGORIE</th>
                                    <th scope="col">VOITURE</th>
                                    <th scope="col" class="numeric-cell">CLASSEMENT</th>
                                    <th scope="col" class="numeric-cell">MEILLEUR TOUR QUALIF</th>
                                    <th scope="col" class="numeric-cell">DELTA QUALIF (n-1)</th>
                                    <th scope="col" class="numeric-cell">GRILLE</th>
                                    <th scope="col" class="numeric-cell">MEILLEUR TOUR COURSE</th>
                                    <th scope="col" class="numeric-cell">DELTA COURSE (n-1)</th>
                                    <th scope="col" class="numeric-cell">TOURS</th>
                                    <th scope="col" class="numeric-cell">TEMPS TOTAL COURSE</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var record in circuit.OrderByDescending(record => record.StartedAt))
                                {
                                    <tr class="@GetPositionClass(record.PositionTier)">
                                        <td class="date-cell">@DisplayFormat.DateTime(record.StartedAt)</td>
                                        <td><span class="category-badge">@record.Category</span></td>
                                        <td class="car-cell"><strong>@record.Car</strong></td>
                                        <td class="numeric-cell position-cell">@record.ResultLabel</td>
                                        <td class="numeric-cell">@DisplayFormat.Lap(record.QualifyingTime)</td>
                                        <td class="numeric-cell">@FormatDelta(record.QualifyingDelta)</td>
                                        <td class="numeric-cell">@(record.GridPosition?.ToString() ?? "—")</td>
                                        <td class="numeric-cell">@DisplayFormat.Lap(record.RaceTime)</td>
                                        <td class="numeric-cell">@FormatDelta(record.RaceDelta)</td>
                                        <td class="numeric-cell">@(record.LapsCompleted?.ToString() ?? "—")</td>
                                        <td class="numeric-cell">@DisplayFormat.TotalTime(record.FinishTime)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </section>
            }
        }
    </section>
}

@code {
    private DashboardState state = new(true, 0, 0, false, null, [], [], null);
    private IReadOnlyList<MyRaceRecord> records = [];
    private string[] tracks = [];
    private string[] categories = [.. CarCategory.Known];
    private string selectedTrack = string.Empty;
    private string selectedCategory = string.Empty;

    protected override void OnInitialized()
    {
        DashboardData.StateChanged += OnDashboardStateChanged;
        UpdateState();
    }

    public void Dispose() => DashboardData.StateChanged -= OnDashboardStateChanged;

    private void OnDashboardStateChanged() =>
        _ = InvokeAsync(() =>
        {
            UpdateState();
            StateHasChanged();
        });

    private void UpdateState()
    {
        state = DashboardData.Snapshot;
        records = MyRacesPresentation.CreateRecords(state.Sessions, state.UserName);
        tracks = [.. MyRacesFilters.GetTracks(records)];
        categories = [.. MyRacesFilters.GetCategories(records)];
    }

    private IReadOnlyList<MyRaceRecord> GetFilteredRecords() =>
        MyRacesFilters.Apply(records, selectedTrack, selectedCategory);

    /// <summary>
    /// Links to the progression page on a circuit, with the category of the latest record there
    /// (taken from every record, so that the category filter of this page does not change it).
    /// </summary>
    private string GetProgressionLink(string trackVenue, string trackCourse)
    {
        var category = records
            .Where(record => string.Equals(record.TrackVenue, trackVenue, StringComparison.OrdinalIgnoreCase)
                && string.Equals(record.TrackCourse, trackCourse, StringComparison.OrdinalIgnoreCase))
            .MaxBy(record => record.StartedAt)
            ?.Category;

        return $"/progression?venue={Uri.EscapeDataString(trackVenue)}&course={Uri.EscapeDataString(trackCourse)}"
            + (category is null ? string.Empty : $"&category={Uri.EscapeDataString(category)}");
    }

    /// <summary>
    /// Returns the row class of a highlighted class position (podium, top 5, top 10).
    /// </summary>
    private static string? GetPositionClass(MyRacePositionTier tier) => tier switch
    {
        MyRacePositionTier.Gold => "position-gold",
        MyRacePositionTier.Silver => "position-silver",
        MyRacePositionTier.Bronze => "position-bronze",
        MyRacePositionTier.TopFive => "position-top5",
        MyRacePositionTier.TopTen => "position-top10",
        _ => null
    };

    private static RenderFragment FormatDelta(TimeSpan? delta) => builder =>
    {
        if (delta is not { } value)
        {
            builder.AddContent(0, "—");
            return;
        }

        var cssClass = value < TimeSpan.Zero
            ? "delta-value delta-gain"
            : value > TimeSpan.Zero
                ? "delta-value delta-loss"
                : "delta-value";
        var indicator = value < TimeSpan.Zero ? "🟢 " : value > TimeSpan.Zero ? "🔴 " : string.Empty;
        var text = indicator + DisplayFormat.Delta(value);
        builder.OpenElement(1, "span");
        builder.AddAttribute(2, "class", cssClass);
        builder.AddContent(3, text);
        builder.CloseElement();
    };
}
