@page "/my-races"
@inherits DashboardPage

<PageTitle>@T["PageTitle", T["Nav.MyRaces"]]</PageTitle>

<section class="page-heading">
    <div>
        <p class="eyebrow">@T["MyRaces.Eyebrow"]</p>
        <h1>@T["Nav.MyRaces"]</h1>
        <p class="page-subtitle">@T["MyRaces.Subtitle"]</p>
    </div>
</section>

<ResultsGate State="State">
@if (records.Count == 0)
{
    <section class="panel empty-state">
        <span class="empty-icon" aria-hidden="true">○</span>
        <h3>@T["Home.EmptyTitle"]</h3>
        <p>@T["Home.EmptyText"]</p>
    </section>
}
else
{
    var filteredRecords = GetFilteredRecords();
    <section class="panel race-history">
        <div class="panel-heading race-history-heading">
            <div>
                <p class="eyebrow">@T["MyRaces.PanelEyebrow"]</p>
                <h2>@T["MyRaces.PanelTitle"]</h2>
            </div>
            <span class="count-badge">@filteredRecords.Count</span>
        </div>

        <div class="race-filters" aria-label="@T["MyRaces.FiltersLabel"]">
            <label class="race-filter">
                <span>@T["Common.Circuit"]</span>
                <select @bind="selectedTrack" aria-label="@T["MyRaces.FilterTrack"]">
                    <option value="">@T["MyRaces.AllTracks"]</option>
                    @foreach (var track in tracks)
                    {
                        <option value="@track">@track</option>
                    }
                </select>
            </label>
            <label class="race-filter">
                <span>@T["Common.Category"]</span>
                <select @bind="selectedCategory" aria-label="@T["MyRaces.FilterCategory"]">
                    <option value="">@T["MyRaces.AllCategories"]</option>
                    @foreach (var category in categories)
                    {
                        <option value="@category">@category</option>
                    }
                </select>
            </label>
        </div>

        @if (filteredRecords.Count == 0)
        {
            <div class="empty-state race-empty-state">
                <p>@T["MyRaces.NoMatch"]</p>
            </div>
        }
        else
        {
            @foreach (var circuit in filteredRecords
                .GroupBy(record => new { record.TrackVenue, record.TrackCourse })
                .OrderBy(group => group.Key.TrackVenue))
            {
                <section class="circuit-history" aria-label="@T["MyRaces.TrackHistory", circuit.Key.TrackVenue]">
                    <div class="circuit-heading">
                        <div>
                            <span class="eyebrow">@T["Common.Circuit"]</span>
                            <h3>@circuit.Key.TrackVenue</h3>
                            @if (!string.Equals(circuit.Key.TrackVenue, circuit.Key.TrackCourse, StringComparison.OrdinalIgnoreCase))
                            {
                                <span class="circuit-course">@circuit.Key.TrackCourse</span>
                            }
                        </div>
                        <div class="circuit-actions">
                            <a class="progression-link"
                               href="@GetProgressionLink(circuit.Key.TrackVenue, circuit.Key.TrackCourse)"
                               aria-label="@T["MyRaces.SeeTrackProgression"]"
                               title="@T["MyRaces.SeeTrackProgression"]">📈</a>
                            <span class="count-badge">@Texts.Plural("MyRaces.Results", circuit.Count())</span>
                        </div>
                    </div>
                    <div class="table-scroll">
                        <table class="data-table races-table" data-resizable-columns>
                            <thead>
                                <tr>
                                    <th scope="col">@T["Common.Category"]</th>
                                    <th scope="col">@T["MyRaces.DateTime"]</th>
                                    <th scope="col">@T["MyRaces.Car"]</th>
                                    <th scope="col" class="numeric-cell">@T["MyRaces.Result"]</th>
                                    <th scope="col" class="numeric-cell">@T["MyRaces.Grid"]</th>
                                    <th scope="col" class="numeric-cell">@T["MyRaces.RaceBestLap"]</th>
                                    <th scope="col" class="numeric-cell">@T["MyRaces.RaceDelta"]</th>
                                    <th scope="col" class="numeric-cell">@T["MyRaces.Laps"]</th>
                                    <th scope="col" class="numeric-cell">@T["MyRaces.RaceTotalTime"]</th>
                                    <th scope="col" class="numeric-cell">@T["MyRaces.QualifyingBestLap"]</th>
                                    <th scope="col" class="numeric-cell">@T["MyRaces.QualifyingDelta"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @* OrderRows keeps each category together: grouping only adds its separator. *@
                                @foreach (var category in MyRacesFilters.OrderRows(circuit).GroupBy(record => record.Category))
                                {
                                    <tr class="category-separator @CategoryStyle.CssClass(category.Key)">
                                        <td colspan="11">
                                            <div class="category-separator-content">
                                                <span class="category-badge @CategoryStyle.CssClass(category.Key)">@category.Key</span>
                                                <a class="category-separator-link"
                                                   href="@ProgressionLink.For(circuit.Key.TrackVenue, circuit.Key.TrackCourse, category.Key)"
                                                   title="@T["MyRaces.SeeCategoryProgression", category.Key]">📈 @T["MyRaces.SeeProgression"]</a>
                                            </div>
                                        </td>
                                    </tr>
                                    @foreach (var record in category)
                                    {
                                        <tr class="@GetPositionClass(record.PositionTier)">
                                            <td><span class="category-badge @CategoryStyle.CssClass(record.Category)">@record.Category</span></td>
                                            <td class="date-cell">@DisplayFormat.DateTime(record.StartedAt)</td>
                                            <td class="car-cell"><strong>@record.Car</strong></td>
                                            <td class="numeric-cell position-cell">
                                                @if (record.IsPodium)
                                                {
                                                    @* Drawn in the colour of the position text: gold, silver or bronze. *@
                                                    <svg class="podium-trophy" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" focusable="false">
                                                        <path d="M7 3h10v4a5 5 0 0 1-10 0z" fill="currentColor" />
                                                        <path d="M7 5H4.5v1.5a3 3 0 0 0 3 3M17 5h2.5v1.5a3 3 0 0 1-3 3M12 12v4M8.5 20h7M9.5 16h5v4h-5z"
                                                              fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                                                    </svg>
                                                }
                                                @record.ResultLabel
                                            </td>
                                            <td class="numeric-cell">@(record.GridPosition?.ToString() ?? "—")</td>
                                            <td class="numeric-cell">@DisplayFormat.Lap(record.RaceTime)</td>
                                            <td class="numeric-cell">@FormatDelta(record.RaceDelta)</td>
                                            <td class="numeric-cell">@(record.LapsCompleted?.ToString() ?? "—")</td>
                                            <td class="numeric-cell">@DisplayFormat.TotalTime(record.FinishTime)</td>
                                            <td class="numeric-cell">@DisplayFormat.Lap(record.QualifyingTime)</td>
                                            <td class="numeric-cell">@FormatDelta(record.QualifyingDelta)</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </section>
            }
        }
    </section>
}

</ResultsGate>

@code {
    private IReadOnlyList<MyRaceRecord> records = [];
    private string[] tracks = [];
    private string[] categories = [.. CarCategory.Known];
    private string selectedTrack = string.Empty;
    private string selectedCategory = string.Empty;

    protected override void OnStateChanged()
    {
        records = MyRacesPresentation.CreateRecords(State.Sessions, State.UserName);
        tracks = [.. MyRacesFilters.GetTracks(records)];
        categories = [.. MyRacesFilters.GetCategories(records)];
    }

    private IReadOnlyList<MyRaceRecord> GetFilteredRecords() =>
        MyRacesFilters.Apply(records, selectedTrack, selectedCategory);

    /// <summary>
    /// Links to the progression page on a circuit, with the category of the latest record there
    /// (taken from every record, so that the category filter of this page does not change it).
    /// </summary>
    private string GetProgressionLink(string trackVenue, string trackCourse)
    {
        var latest = records
            .Where(record => string.Equals(record.TrackVenue, trackVenue, StringComparison.OrdinalIgnoreCase)
                && string.Equals(record.TrackCourse, trackCourse, StringComparison.OrdinalIgnoreCase))
            .MaxBy(record => record.StartedAt);

        return ProgressionLink.For(trackVenue, trackCourse, latest?.Category ?? string.Empty);
    }

    /// <summary>
    /// Returns the row class of a highlighted class position (podium, top 5, top 10).
    /// </summary>
    private static string? GetPositionClass(MyRacePositionTier tier) => tier switch
    {
        MyRacePositionTier.Gold => "position-gold",
        MyRacePositionTier.Silver => "position-silver",
        MyRacePositionTier.Bronze => "position-bronze",
        MyRacePositionTier.TopFive => "position-top5",
        MyRacePositionTier.TopTen => "position-top10",
        _ => null
    };

    private static RenderFragment FormatDelta(TimeSpan? delta) => builder =>
    {
        if (delta is not { } value)
        {
            builder.AddContent(0, "—");
            return;
        }

        var cssClass = value < TimeSpan.Zero
            ? "delta-value delta-gain"
            : value > TimeSpan.Zero
                ? "delta-value delta-loss"
                : "delta-value";
        var indicator = value < TimeSpan.Zero ? "🟢 " : value > TimeSpan.Zero ? "🔴 " : string.Empty;
        var text = indicator + DisplayFormat.Delta(value);
        builder.OpenElement(1, "span");
        builder.AddAttribute(2, "class", cssClass);
        builder.AddContent(3, text);
        builder.CloseElement();
    };
}
