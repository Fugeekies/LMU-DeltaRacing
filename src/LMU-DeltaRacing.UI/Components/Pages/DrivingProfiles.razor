@page "/driving-profiles"
@inherits DashboardPage

<PageTitle>Profils de conduite | LMU DeltaRacing</PageTitle>

<section class="page-heading">
    <div>
        <p class="eyebrow">PROPRETÉ &amp; DISCIPLINE EN PISTE</p>
        <h1>Profils de conduite</h1>
        <p class="page-subtitle">Contacts, limites de piste et pénalités de chaque pilote, sur les qualifications et les courses importées.</p>
    </div>
</section>

<ResultsGate State="State">
@if (profiles.Count == 0)
{
    <section class="panel empty-state">
        <span class="empty-icon" aria-hidden="true">○</span>
        <h3>Aucun profil disponible</h3>
        <p>Les profils apparaîtront lorsque des qualifications ou des courses auront été importées.</p>
    </section>
}
else
{
    var filteredProfiles = GetFilteredProfiles();
    <section class="panel ranking-panel">
        <div class="panel-heading">
            <div>
                <p class="eyebrow">QUALIFICATIONS &amp; COURSES</p>
                <h2>Pilotes rencontrés</h2>
            </div>
            <span class="count-badge">@filteredProfiles.Count</span>
        </div>

        <div class="ranking-filters">
            <label class="ranking-filter ranking-search">
                <span>RECHERCHER UN PILOTE</span>
                <input @bind="searchText"
                       @bind:event="oninput"
                       type="search"
                       placeholder="Nom du pilote…"
                       aria-label="Rechercher un pilote par nom" />
            </label>
            <label class="ranking-filter">
                <span>TRIER PAR</span>
                <select @bind="sortOrder" aria-label="Trier les profils">
                    <option value="sessions">Sessions (décroissant)</option>
                    <option value="contacts">Contacts pour 100 tours (décroissant)</option>
                    <option value="warnings">Avertissements (décroissant)</option>
                    <option value="invalid">Tours invalidés (décroissant)</option>
                    <option value="penalties">Pénalités (décroissant)</option>
                    <option value="name">Nom (A à Z)</option>
                </select>
            </label>
        </div>

        @if (filteredProfiles.Count == 0)
        {
            <div class="empty-state race-empty-state">
                <p>Aucun pilote ne correspond à cette recherche.</p>
            </div>
        }
        else
        {
            <div class="table-scroll">
                <table class="data-table ranking-table">
                    <thead>
                        <tr>
                            <th scope="col">NOM DU PILOTE</th>
                            <th scope="col" class="numeric-cell">SESSIONS</th>
                            <th scope="col" class="numeric-cell">TOURS</th>
                            <th scope="col" class="numeric-cell">CONTACTS</th>
                            <th scope="col" class="numeric-cell">OBSTACLES</th>
                            <th scope="col" class="numeric-cell">POUR 100 TOURS</th>
                            <th scope="col" class="numeric-cell">AVERTISSEMENTS</th>
                            <th scope="col" class="numeric-cell">TOURS INVALIDÉS</th>
                            <th scope="col" class="numeric-cell">PÉNALITÉS</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var profile in filteredProfiles)
                        {
                            <tr class="@(profile.IsPlayer ? "player-row" : string.Empty)">
                                <td class="ranking-driver">
                                    @profile.Name
                                    @if (profile.IsPlayer)
                                    {
                                        <span class="player-tag">VOUS</span>
                                    }
                                </td>
                                <td class="numeric-cell">@profile.Sessions</td>
                                <td class="numeric-cell">@profile.Laps</td>
                                <td class="numeric-cell">@profile.Conduct.VehicleContacts</td>
                                <td class="numeric-cell">@profile.Conduct.ObstacleContacts</td>
                                <td class="numeric-cell">@FormatRate(profile.ContactsPer100Laps)</td>
                                <td class="numeric-cell">@profile.Conduct.Warnings</td>
                                <td class="numeric-cell">@profile.Conduct.InvalidLaps</td>
                                <td class="numeric-cell">@profile.Conduct.Penalties</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <div class="sector-legend">
            <span>Un contact compte une fois pour chaque pilote impliqué, quelle que soit la voiture qui l'a signalé.</span>
            <span>LMU ne signale de tours invalidés qu'en essais et en qualification ; en course, voir les avertissements.</span>
        </div>
    </section>
}

</ResultsGate>

@code {
    private IReadOnlyList<DrivingProfile> profiles = [];
    private string searchText = string.Empty;
    private string sortOrder = "sessions";

    protected override void OnStateChanged()
    {
        profiles = DrivingConductPresentation.CreateProfiles(State.Sessions, State.UserName);
    }

    private static string FormatRate(double? rate) =>
        rate?.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture) ?? "—";

    private IReadOnlyList<DrivingProfile> GetFilteredProfiles()
    {
        var filtered = profiles.Where(profile =>
            string.IsNullOrWhiteSpace(searchText)
            || profile.Name.Contains(searchText, StringComparison.OrdinalIgnoreCase));

        var ordered = sortOrder switch
        {
            "contacts" => filtered.OrderByDescending(profile => profile.ContactsPer100Laps ?? -1),
            "warnings" => filtered.OrderByDescending(profile => profile.Conduct.Warnings),
            "invalid" => filtered.OrderByDescending(profile => profile.Conduct.InvalidLaps),
            "penalties" => filtered.OrderByDescending(profile => profile.Conduct.Penalties),
            "name" => filtered.OrderBy(profile => 0),
            _ => filtered.OrderByDescending(profile => profile.Sessions)
        };

        return ordered
            .ThenBy(profile => profile.Name, StringComparer.OrdinalIgnoreCase)
            .ToArray();
    }
}
