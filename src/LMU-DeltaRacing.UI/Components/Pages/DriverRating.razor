@page "/rating"
@inherits DashboardPage

<PageTitle>@T["PageTitle", T["Nav.DriverRating"]]</PageTitle>

<section class="page-heading">
    <div>
        <p class="eyebrow">@T["DriverRating.Eyebrow"]</p>
        <h1>@T["Nav.DriverRating"]</h1>
        <p class="page-subtitle">
            @(view is null
                ? T["DriverRating.Subtitle"]
                : T["DriverRating.SubtitleOf", view.Name, Texts.Plural("DriverRating.RatedRacesCount", view.Races)])
        </p>
    </div>
</section>

<ResultsGate State="State">
@if (view is null)
{
    <section class="panel empty-state">
        <span class="empty-icon" aria-hidden="true">○</span>
        <h3>@T["DriverRating.EmptyTitle"]</h3>
        <p>@T["DriverRating.EmptyText"]</p>
    </section>
}
else
{
    <section class="panel rating-hero" aria-label="@T["DriverRating.YourRatingLabel"]">
        <div class="rating-hero-main">
            <p class="eyebrow">@(view.IsProvisional ? T["DriverRating.Provisional"] : T["DriverRating.YourRating"])</p>
            <div class="rating-hero-value">
                <strong>@DisplayFormat.Rating(view.Rating)</strong>
                @if (view.Tier is { } tier)
                {
                    <span class="tier-badge @TierStyle.CssClass(tier)">@DriverRatingPresentation.Label(tier).ToUpperInvariant()</span>
                }
            </div>
            @if (view.Rank is { } rank)
            {
                <span class="summary-detail">
                    @T["DriverRating.RankOf", DisplayFormat.Position(rank), view.RankedDrivers, TopPercent(rank, view.RankedDrivers)]
                </span>
            }
            else
            {
                <span class="summary-detail">
                    @Texts.Plural("DriverRating.RacesToCalibrate", view.RacesToCalibrate)
                </span>
            }
            <span class="summary-detail">@T["DriverRating.Peak", DisplayFormat.Rating(view.Peak), DisplayFormat.Day(view.PeakAt)]</span>
        </div>

        @if (!view.IsProvisional)
        {
            <div class="rating-goals">
                <p class="eyebrow">@T["DriverRating.NextGoals"]</p>
                <ul>
                    @if (view.NextRival is { } rival)
                    {
                        <li><strong>+@rival.Points</strong> @T["DriverRating.ToPass", rival.Label, DisplayFormat.Position(view.Rank - 1)]</li>
                    }
                    else
                    {
                        <li>@T["DriverRating.Leading"]</li>
                    }
                    @if (view.NextTier is { } nextTier)
                    {
                        <li><strong>+@nextTier.Points</strong> @T["DriverRating.ToEnter", nextTier.Label]</li>
                    }
                    else if (view.Tier == RatingTier.Platinum)
                    {
                        <li>@T["DriverRating.Platinum"]</li>
                    }
                </ul>
            </div>
        }

        <div class="driving-cost-figures">
            <div>
                <strong class="@GetChangeClass(view.RecentChange)">@DisplayFormat.RatingChange(view.RecentChange)</strong>
                <span>@Texts.Plural("DriverRating.OverLastRaces", view.RecentRaces)</span>
            </div>
            <div><strong>@DisplayFormat.Rating(view.AverageFieldStrength)</strong><span>@T["DriverRating.AverageFieldStrength"]</span></div>
            <div><strong>@view.RacesAboveExpectation / @view.Races</strong><span>@T["DriverRating.AboveExpectation"]</span></div>
            <div><strong>@view.Races</strong><span>@T["DriverRating.RatedRaces"]</span></div>
        </div>
    </section>

    <section class="panel driving-panel rating-chart-panel">
        <div class="panel-heading">
            <div>
                <p class="eyebrow">@T["DriverRating.Evolution"]</p>
                <h2>@T["DriverRating.EvolutionTitle"]</h2>
            </div>
        </div>
        <div class="rating-chart-body">
            <RatingChart View="view" />
        </div>
    </section>

    <section class="driving-lists rating-highlights">
        @RenderHighlights(T["DriverRating.Exploits"], T["DriverRating.ExploitsSubtitle"], view.Exploits, T["DriverRating.NoExploit"])
        @RenderHighlights(T["DriverRating.Setbacks"], T["DriverRating.SetbacksSubtitle"], view.Setbacks, T["DriverRating.NoSetback"])
    </section>

    <section class="panel driving-panel">
        <div class="panel-heading">
            <div>
                <p class="eyebrow">@T["DriverRating.History"]</p>
                <h2>@T["DriverRating.HistoryTitle"]</h2>
            </div>
            @if (view.Timeline.Count > ShortHistory)
            {
                <button type="button" class="button button-secondary" aria-expanded="@(showsAllRaces ? "true" : "false")" @onclick="() => showsAllRaces = !showsAllRaces">
                    @(showsAllRaces ? T["DriverRating.ShowLast", ShortHistory] : T["DriverRating.ShowAllRaces", view.Timeline.Count])
                </button>
            }
        </div>
        <div class="table-scroll">
            <table class="data-table driving-table rating-table" data-resizable-columns>
                <thead>
                    <tr>
                        <th scope="col">@T["DrivingProfile.Date"]</th>
                        <th scope="col">@T["Common.Circuit"]</th>
                        <th scope="col">@T["Common.Category"]</th>
                        <th scope="col" class="numeric-cell">@T["DriverRating.Result"]</th>
                        <th scope="col" class="numeric-cell">@T["DriverRating.Expected"]</th>
                        <th scope="col" class="numeric-cell">@T["DriverRating.Drivers"]</th>
                        <th scope="col" class="numeric-cell">@T["RaceDetails.FieldStrength"]</th>
                        <th scope="col" class="numeric-cell">@T["DriverRating.Change"]</th>
                        <th scope="col" class="numeric-cell">@T["DriverRating.Rating"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var race in view.Timeline.Reverse().Take(showsAllRaces ? int.MaxValue : ShortHistory))
                    {
                        <tr>
                            <td class="date-cell">@RenderRaceLink(race)</td>
                            <td>@race.TrackVenue</td>
                            <td><span class="category-badge @CategoryStyle.CssClass(race.Category)">@race.Category</span></td>
                            <td class="numeric-cell"><span class="form-pill form-@race.Kind.ToString().ToLowerInvariant()">@race.Result</span></td>
                            <td class="numeric-cell @(race.ClassRank < race.ExpectedRank ? "delta-best" : "delta-unavailable")">@DisplayFormat.Average(race.ExpectedRank)</td>
                            <td class="numeric-cell">@race.FieldSize</td>
                            <td class="numeric-cell">@DisplayFormat.Rating(race.FieldStrength)</td>
                            <td class="numeric-cell"><span class="delta-value @GetChangeClass(race.Delta)">@DisplayFormat.RatingChange(race.Delta)</span></td>
                            <td class="numeric-cell">@DisplayFormat.Rating(race.After)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="sector-legend">
            <span>@T["DriverRating.ExpectedNote"]</span>
            <span>@T["DriverRating.FieldStrengthNote"]</span>
        </div>
    </section>

    <section class="panel driving-panel">
        <div class="panel-heading">
            <div>
                <p class="eyebrow">@T["DriverRating.Ranking"]</p>
                <h2>@T["DriverRating.RankingTitle"]</h2>
            </div>
            @if (view.Leaderboard.Count > shortlist.Count)
            {
                <button type="button" class="button button-secondary" aria-expanded="@(showsAllDrivers ? "true" : "false")" @onclick="() => showsAllDrivers = !showsAllDrivers">
                    @(showsAllDrivers ? T["DriverRating.ShowTop10"] : T["DriverRating.ShowAllDrivers", view.Leaderboard.Count])
                </button>
            }
        </div>
        @if (view.Leaderboard.Count == 0)
        {
            <div class="empty-state race-empty-state">
                <p>@T["DriverRating.NoRankedDriver", DriverRatings.CalibrationRaces]</p>
            </div>
        }
        else
        {
            <div class="table-scroll">
                <table class="data-table driving-table rating-table" data-resizable-columns>
                    <thead>
                        <tr>
                            <th scope="col" class="numeric-cell">@T["DriverRating.Rank"]</th>
                            <th scope="col">@T["RaceDetails.Driver"]</th>
                            <th scope="col">@T["DriverRating.Tier"]</th>
                            <th scope="col" class="numeric-cell">@T["DriverRating.Rating"]</th>
                            <th scope="col" class="numeric-cell">@T["Home.Races"]</th>
                            <th scope="col" class="numeric-cell">@T["Home.LastRace"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ var previousRank = 0; }
                        @foreach (var row in showsAllDrivers ? view.Leaderboard : shortlist)
                        {
                            @if (row.Rank > previousRank + 1)
                            {
                                <tr class="rating-gap" aria-hidden="true"><td colspan="6">⋯</td></tr>
                            }
                            previousRank = row.Rank;
                            <tr class="@(row.IsPlayer ? "player-row" : null)">
                                <td class="numeric-cell position-value">@row.Rank</td>
                                <td>
                                    @row.Name
                                    @if (row.IsPlayer)
                                    {
                                        <span class="player-tag">@T["RaceDetails.You"]</span>
                                    }
                                </td>
                                <td><span class="tier-badge @TierStyle.CssClass(row.Tier)">@DriverRatingPresentation.Label(row.Tier).ToUpperInvariant()</span></td>
                                <td class="numeric-cell">@DisplayFormat.Rating(row.Rating)</td>
                                <td class="numeric-cell">@row.Races</td>
                                <td class="numeric-cell date-cell">@DisplayFormat.Day(row.LastRaceAt)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        <div class="sector-legend">
            <span>@T["DriverRating.TiersNote"]</span>
            <span>@T["DriverRating.RankedAfter", DriverRatings.CalibrationRaces]</span>
        </div>
    </section>

    <details class="panel rating-method">
        <summary>@T["DriverRating.HowTitle"]</summary>
        <ul>
            <li>@T["DriverRating.HowDuels"]</li>
            <li>@T["DriverRating.HowStart", DisplayFormat.Rating(DriverRatings.InitialRating), DriverRatings.CalibrationRaces]</li>
            <li>@T["DriverRating.HowFormula"]</li>
            <li>@T["DriverRating.HowBounds"]</li>
            <li>@T["DriverRating.HowRacesOnly"]</li>
            <li>@T["DriverRating.HowMerges"]</li>
        </ul>
    </details>
}

</ResultsGate>

@code {
    private const int ShortHistory = 15;

    private DriverRatingView? view;
    private IReadOnlyList<RatingLeaderboardRow> shortlist = [];
    private bool showsAllRaces;
    private bool showsAllDrivers;

    protected override void OnStateChanged()
    {
        view = DriverRatingPresentation.Create(State.Sessions, State.UserName);
        shortlist = view is null ? [] : DriverRatingPresentation.Shortlist(view.Leaderboard);
    }

    // Rounded up: the 9th of 228 drivers is in the top 4 %, not in the top 3 %.
    private static int TopPercent(int rank, int rankedDrivers) =>
        (int)Math.Ceiling(rank * 100.0 / rankedDrivers);

    private static string GetChangeClass(double change) =>
        Math.Round(change, MidpointRounding.AwayFromZero) switch
        {
            > 0 => "delta-best",
            < 0 => "delta-loss",
            _ => "delta-unavailable"
        };

    private static RenderFragment RenderRaceLink(RatingRaceEntry race) =>
        @<text>
            @if (race.EventId is { } eventId)
            {
                <a href="@($"/race-details?event={Uri.EscapeDataString(eventId)}")">@DisplayFormat.DateTime(race.StartedAt)</a>
            }
            else
            {
                @DisplayFormat.DateTime(race.StartedAt)
            }
        </text>;

    private static RenderFragment RenderHighlights(string title, string subtitle, IReadOnlyList<RatingRaceEntry> races, string empty) =>
        @<article class="panel driving-list rating-highlight">
            <h3 class="summary-label">@title</h3>
            <p class="rating-highlight-subtitle">@subtitle</p>
            @if (races.Count == 0)
            {
                <p class="incident-empty">@empty</p>
            }
            else
            {
                <ol>
                    @foreach (var race in races)
                    {
                        <li>
                            <span class="rating-highlight-race">
                                <span>@RenderRaceLink(race) · @race.TrackVenue</span>
                                <span class="rating-highlight-detail">
                                    @Texts.Format("DriverRating.HighlightDetail", race.Result, race.FieldSize, DisplayFormat.Average(race.ExpectedRank), DisplayFormat.Rating(race.FieldStrength))
                                </span>
                            </span>
                            <strong class="@GetChangeClass(race.Delta)">@DisplayFormat.RatingChange(race.Delta)</strong>
                        </li>
                    }
                </ol>
            }
        </article>;
}
