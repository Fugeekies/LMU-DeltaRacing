@inherits LayoutComponentBase
@implements IDisposable
@inject DashboardDataService DashboardData
@inject NavigationManager Navigation

@* No page is rendered behind the startup screen: without this title, the tab would show the address. Pages replace it. *@
<PageTitle>LMU DeltaRacing</PageTitle>

@if (StartupLoadingPresentation.IsVisible(state))
{
    <StartupLoadingScreen Progress="@StartupLoadingPresentation.ProgressPercent(state)"
                          Caption="@StartupLoadingPresentation.Caption(state)" />
}
else
{
    <div class="app-shell">
        <header class="topbar">
            <div class="topbar-inner">
                <a class="brand" href="/" aria-label="@T["Nav.HomeLink"]">
                    <img class="brand-mark" src="@Assets["favicon.ico"]" alt="" />
                    <span class="brand-name">LMU DELTA<span class="brand-accent">RACING</span></span>
                </a>
                <nav class="primary-nav" aria-label="@T["Nav.Label"]">
                    <NavLink href="/" Match="NavLinkMatch.All">@T["Nav.Home"]</NavLink>
                    @RenderGroup(T["Nav.GroupRaces"], ("my-races", T["Nav.MyRaces"]), ("race-details", T["Nav.RaceDetails"]))
                    @RenderGroup(T["Nav.GroupPerformance"], ("progression", T["Nav.Progression"]), ("driving-profile", T["Nav.DrivingProfile"]))
                    @RenderGroup(T["Nav.GroupDrivers"], ("rating", T["Nav.DriverRating"]), ("drivers-ranking", T["Nav.DriversRanking"]))
                    <NavLink href="/settings">@T["Nav.Settings"]</NavLink>
                </nav>
                <div class="system-status" role="status" aria-live="polite">
                    <span class="active-driver" title="@state.UserName">
                        @(string.IsNullOrWhiteSpace(state.UserName) ? T["Layout.NoDriver"] : state.UserName)
                    </span>
                    <span class="status-dot @GetStatusClass()" aria-hidden="true"></span>
                    <span>@GetStatusLabel()</span>
                </div>
            </div>
        </header>

        <main class="main-content">
            @Body
        </main>

        <footer class="app-footer">
            <span>@T["Layout.FooterGame"]</span>
            <span>@T["Layout.FooterPrivacy"]</span>
        </footer>

        <UpdateNotice />
    </div>
}

<div id="blazor-error-ui" data-nosnippet>
    @T["Layout.Error"]
    <a href="." class="reload">@T["Layout.Reload"]</a>
    <span class="dismiss">@T["Layout.Dismiss"]</span>
</div>

@code {
    private DashboardState state = DashboardState.Initial;

    protected override void OnInitialized()
    {
        DashboardData.StateChanged += OnDashboardStateChanged;
        Navigation.LocationChanged += OnLocationChanged;
        state = DashboardData.Snapshot;
    }

    public void Dispose()
    {
        DashboardData.StateChanged -= OnDashboardStateChanged;
        Navigation.LocationChanged -= OnLocationChanged;
    }

    // NavLink only marks its own page: the group label is marked here when one of its pages is shown.
    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) =>
        _ = InvokeAsync(StateHasChanged);

    private string CurrentPage()
    {
        var path = Navigation.ToBaseRelativePath(Navigation.Uri);
        var end = path.IndexOfAny(['?', '#', '/']);
        return end < 0 ? path : path[..end];
    }

    /// <summary>
    /// Renders a group of the navigation bar: its label, which opens the first page and shows the
    /// menu of its pages on hover or focus. On phones the pages are shown as plain tabs instead.
    /// </summary>
    private RenderFragment RenderGroup(string label, params (string Page, string Label)[] pages)
    {
        var current = CurrentPage();
        var isActive = pages.Any(page => string.Equals(page.Page, current, StringComparison.OrdinalIgnoreCase));
        return @<div class="nav-group">
            <a class="nav-group-toggle @(isActive ? "active" : null)" href="@($"/{pages[0].Page}")">
                @label<span class="nav-chevron" aria-hidden="true"></span>
            </a>
            <div class="nav-menu">
                @foreach (var entry in pages)
                {
                    <NavLink href="@($"/{entry.Page}")">@entry.Label</NavLink>
                }
            </div>
        </div>;
    }

    private void OnDashboardStateChanged() =>
        _ = InvokeAsync(() =>
        {
            state = DashboardData.Snapshot;
            StateHasChanged();
        });

    private string GetStatusClass() =>
        !string.IsNullOrWhiteSpace(state.ErrorMessage)
            ? "is-error"
            : state.IsWatching
                ? "is-live"
                : "is-idle";

    private string GetStatusLabel() =>
        !string.IsNullOrWhiteSpace(state.ErrorMessage)
            ? T["Status.Unavailable"]
            : state.IsLoading
                ? T["Status.InitialImport"]
                : state.IsWatching
                    ? T["Status.Watching"]
                    : T["Status.NotWatching"];
}
