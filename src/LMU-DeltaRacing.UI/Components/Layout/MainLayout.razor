@inherits LayoutComponentBase
@implements IDisposable
@inject DashboardDataService DashboardData

@* No page is rendered behind the startup screen: without this title, the tab would show the address. Pages replace it. *@
<PageTitle>LMU DeltaRacing</PageTitle>

@if (StartupLoadingPresentation.IsVisible(state))
{
    <StartupLoadingScreen Progress="@StartupLoadingPresentation.ProgressPercent(state)"
                          Caption="@StartupLoadingPresentation.Caption(state)" />
}
else
{
    <div class="app-shell">
        <header class="topbar">
            <div class="topbar-inner">
                <a class="brand" href="/" aria-label="@T["Nav.HomeLink"]">
                    <img class="brand-mark" src="@Assets["favicon.ico"]" alt="" />
                    <span class="brand-name">LMU DELTA<span class="brand-accent">RACING</span></span>
                </a>
                <nav class="primary-nav" aria-label="@T["Nav.Label"]">
                    <NavLink href="/" Match="NavLinkMatch.All">@T["Nav.Home"]</NavLink>
                    <NavLink href="/my-races">@T["Nav.MyRaces"]</NavLink>
                    <NavLink href="/race-details">@T["Nav.RaceDetails"]</NavLink>
                    <NavLink href="/progression">@T["Nav.Progression"]</NavLink>
                    <NavLink href="/driving-profile">@T["Nav.DrivingProfile"]</NavLink>
                    <NavLink href="/rating">@T["Nav.DriverRating"]</NavLink>
                    <NavLink href="/drivers-ranking">@T["Nav.DriversRanking"]</NavLink>
                    <NavLink href="/settings">@T["Nav.Settings"]</NavLink>
                </nav>
                <div class="system-status" role="status" aria-live="polite">
                    <span class="active-driver" title="@state.UserName">
                        @(string.IsNullOrWhiteSpace(state.UserName) ? T["Layout.NoDriver"] : state.UserName)
                    </span>
                    <span class="status-dot @GetStatusClass()" aria-hidden="true"></span>
                    <span>@GetStatusLabel()</span>
                </div>
            </div>
        </header>

        <main class="main-content">
            @Body
        </main>

        <footer class="app-footer">
            <span>@T["Layout.FooterGame"]</span>
            <span>@T["Layout.FooterPrivacy"]</span>
        </footer>

        <UpdateNotice />
    </div>
}

<div id="blazor-error-ui" data-nosnippet>
    @T["Layout.Error"]
    <a href="." class="reload">@T["Layout.Reload"]</a>
    <span class="dismiss">@T["Layout.Dismiss"]</span>
</div>

@code {
    private DashboardState state = DashboardState.Initial;

    protected override void OnInitialized()
    {
        DashboardData.StateChanged += OnDashboardStateChanged;
        state = DashboardData.Snapshot;
    }

    public void Dispose() => DashboardData.StateChanged -= OnDashboardStateChanged;

    private void OnDashboardStateChanged() =>
        _ = InvokeAsync(() =>
        {
            state = DashboardData.Snapshot;
            StateHasChanged();
        });

    private string GetStatusClass() =>
        !string.IsNullOrWhiteSpace(state.ErrorMessage)
            ? "is-error"
            : state.IsWatching
                ? "is-live"
                : "is-idle";

    private string GetStatusLabel() =>
        !string.IsNullOrWhiteSpace(state.ErrorMessage)
            ? T["Status.Unavailable"]
            : state.IsLoading
                ? T["Status.InitialImport"]
                : state.IsWatching
                    ? T["Status.Watching"]
                    : T["Status.NotWatching"];
}
