@inherits DashboardPage

<section class="page-heading">
    <div>
        <p class="eyebrow">@T["Overview.Eyebrow"]</p>
        <h1>@T["Overview.Title"]</h1>
        <p class="page-subtitle">@T["Overview.Subtitle"]</p>
    </div>
</section>

@if (State.IsLoading)
{
    var progress = State.FilesToLoad == 0
        ? 100
        : (int)Math.Round(State.FilesLoaded * 100d / State.FilesToLoad);
    <section class="load-panel" aria-live="polite">
        <div class="load-copy">
            <span class="eyebrow">@T["Status.InitialImport"]</span>
            <span>@State.FilesLoaded / @State.FilesToLoad fichiers traités</span>
        </div>
        <progress class="load-progress" max="100" value="@progress" aria-label="@T["Startup.ProgressLabel"]">
            @progress%
        </progress>
    </section>
}

@if (!string.IsNullOrWhiteSpace(State.ErrorMessage))
{
    <section class="notice notice-error" role="alert">
        <span class="notice-symbol" aria-hidden="true">!</span>
        <div>
            <h2>@T["Results.LoadFailed"]</h2>
            <p>@State.ErrorMessage</p>
            <p>@T["Results.CheckFolder"] <a href="/settings">@T["Nav.Settings"]</a>.</p>
        </div>
    </section>
}

<section class="summary-grid" aria-label="@T["Overview.SummaryLabel"]">
    <article class="summary-card">
        <span class="summary-label">@T["Overview.ImportedSessions"]</span>
        <strong class="summary-value">@playerSessions.Count</strong>
        <span class="summary-detail">@T["Overview.SessionsOf", GetDriverLabel()]</span>
    </article>
    <article class="summary-card summary-card-accent">
        <span class="summary-label">@T["Overview.LastSession"]</span>
        <strong class="summary-value summary-value-text">
            @(playerSessions.FirstOrDefault()?.TrackVenue ?? "—")
        </strong>
        <span class="summary-detail">
            @(playerSessions.FirstOrDefault() is { } latest ? DisplayFormat.DateTime(latest.StartedAt) : T["Overview.NoSession"])
        </span>
    </article>
    <article class="summary-card">
        <span class="summary-label">@T["Overview.FailedFiles"]</span>
        <strong class="summary-value @(State.ImportFailures.Count > 0 ? "text-warning" : string.Empty)">
            @State.ImportFailures.Count
        </strong>
        <span class="summary-detail">
            @(State.ImportDuplicates.Count > 0
                ? DashboardPresentation.DuplicateLabel(State.ImportDuplicates.Count)
                : T["Overview.OthersContinue"])
        </span>
    </article>
</section>

@if (State.ImportFailures.Count > 0)
{
    <section class="notice notice-warning" aria-live="polite">
        <div>
            <h2>@T["Overview.SomeFilesFailed"]</h2>
            <ul class="failure-list">
                @foreach (var failure in State.ImportFailures)
                {
                    <li><strong>@failure.SourceFile</strong><span>@failure.ErrorMessage</span></li>
                }
            </ul>
        </div>
    </section>
}

<section class="dashboard-content">
    <article class="panel sessions-panel">
        <div class="panel-heading">
            <div>
                <p class="eyebrow">@T["Overview.ArchivesEyebrow"]</p>
                <h2>@T["Overview.RecentSessionsOf", GetDriverLabel()]</h2>
            </div>
            <span class="count-badge">@playerSessions.Count</span>
        </div>

        @if (State.IsLoading && playerSessions.Count == 0)
        {
            <div class="empty-state">
                <span class="loading-spinner" aria-hidden="true"></span>
                <p>@T["Overview.Reading"]</p>
            </div>
        }
        else if (playerSessions.Count == 0)
        {
            <div class="empty-state">
                <span class="empty-icon" aria-hidden="true">○</span>
                <h3>@T["Overview.NoDriverSession"]</h3>
                <p>@T["Overview.NoDriverSessionText"]</p>
            </div>
        }
        else
        {
            <div class="table-scroll">
                <table class="data-table sessions-table" data-resizable-columns>
                    <thead>
                        <tr>
                            <th scope="col">@T["MyRaces.DateTime"]</th>
                            <th scope="col">@T["Common.Circuit"]</th>
                            <th scope="col">@T["Overview.Event"]</th>
                            <th scope="col">@T["Progression.Session"]</th>
                            <th scope="col">@T["MyRaces.Car"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var session in playerSessions)
                        {
                            var driver = DriverProfile.FindDriver(session, State.UserName);
                            <tr class="session-row">
                                <td class="date-cell">@DisplayFormat.DateTime(session.StartedAt)</td>
                                <td class="track-cell">
                                    <strong>@session.TrackVenue</strong>
                                    <span>@session.TrackCourse</span>
                                </td>
                                <td>@session.TrackEvent</td>
                                <td><span class="session-type">@session.SessionType</span></td>
                                <td>@(driver?.CarName() ?? DisplayFormat.Missing)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </article>
</section>

@code {
    private IReadOnlyList<Session> playerSessions = [];

    private string GetDriverLabel() =>
        string.IsNullOrWhiteSpace(State.UserName) ? T["Overview.SelectedDriver"] : State.UserName;

    protected override void OnStateChanged() =>
        playerSessions = DashboardPresentation.OrderSessions(DriverProfile.FilterSessions(State.Sessions, State.UserName));
}
