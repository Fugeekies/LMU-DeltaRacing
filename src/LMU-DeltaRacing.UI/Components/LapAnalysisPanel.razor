@using LMU_DeltaRacing.UI.Models

@{
    var chart = LapTimesChartLayout.Create(Analysis, Player, measure);
    var hasFuel = Analysis.Laps.Any(lap => lap.Telemetry.Fuel.HasValue);
    var hasEnergy = Analysis.Laps.Any(lap => lap.Telemetry.VirtualEnergy.HasValue);
    var hasTyres = Analysis.Laps.Any(lap => lap.Telemetry.TyreWear is not null);
    var personalBests = Analysis.Sectors.ToDictionary(sector => sector.Number, sector => sector.Best);
    var largestGap = Analysis.Sectors.Max(sector => sector.GapToClassPace is { } gap && gap > TimeSpan.Zero ? gap.TotalSeconds : 0);
}

<section class="lap-analysis" aria-label="@T["LapAnalysis.Label"]">
    <div class="analysis-tiles">
        <article class="summary-card">
            <span class="summary-label">@T["LapAnalysis.Pace"]</span>
            <strong class="summary-value">@DisplayFormat.Lap(Analysis.Regularity?.Pace)</strong>
            <span class="summary-detail">@T["LapAnalysis.BestLapDetail", DisplayFormat.Lap(Analysis.BestLap)]</span>
        </article>
        <article class="summary-card">
            <span class="summary-label">@T["LapAnalysis.Regularity"]</span>
            <strong class="summary-value">@DisplayFormat.Deviation(Analysis.Regularity?.Deviation)</strong>
            <span class="summary-detail">
                @(Analysis.Regularity is { } regularity
                    ? T["LapAnalysis.RegularityRank", regularity.ClassRank, regularity.ClassDrivers]
                    : T["LapAnalysis.NoRegularity"])
            </span>
        </article>
        <article class="summary-card">
            <span class="summary-label">@T["LapAnalysis.IdealLap"]</span>
            <strong class="summary-value">@DisplayFormat.Lap(Analysis.IdealLap)</strong>
            <span class="summary-detail">@T["LapAnalysis.IdealGap", FormatSeconds(Analysis.BestLap - Analysis.IdealLap)]</span>
        </article>
        <article class="summary-card">
            <span class="summary-label">@T["LapAnalysis.TopSpeed"]</span>
            <strong class="summary-value">@DisplayFormat.Speed(Analysis.TopSpeed?.Speed)</strong>
            <span class="summary-detail">@T["LapAnalysis.ClassTopSpeed", DisplayFormat.Speed(Analysis.TopSpeed?.ClassBest)]</span>
        </article>
        <article class="summary-card">
            <span class="summary-label">@T["LapAnalysis.PitStops"]</span>
            <strong class="summary-value">@(Analysis.PitStops?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? DisplayFormat.Missing)</strong>
            <span class="summary-detail">@Texts.Plural("LapAnalysis.StintCount", Analysis.Stints.Count)</span>
        </article>
        @if (Analysis.Consumption?.FuelPerLap is { } fuel)
        {
            <article class="summary-card">
                <span class="summary-label">@T["LapAnalysis.FuelPerLap"]</span>
                <strong class="summary-value">@DisplayFormat.Percent(fuel)</strong>
                <span class="summary-detail">@T["LapAnalysis.LapsPerTank", DisplayFormat.Average(Analysis.Consumption.LapsPerTank)]</span>
            </article>
        }
    </div>
    <p class="lap-analysis-note">
        @(Analysis.Regularity is { } counted ? T["LapAnalysis.RegularityNote", counted.Laps, counted.ExcludedLaps] : string.Empty)
    </p>

    <h3 class="lap-analysis-heading">@T["LapAnalysis.Sectors"]</h3>
    <p class="lap-analysis-lead">
        @(Analysis.WeakestSector is { } weakest
            ? T["LapAnalysis.WeakestSector", weakest, FormatSeconds(Analysis.Sectors[weakest - 1].GapToClassPace)]
            : T["LapAnalysis.NoSectorLoss"])
    </p>
    <div class="table-scroll">
        <table class="data-table lap-analysis-table sector-analysis-table" data-resizable-columns>
            <thead>
                <tr>
                    <th scope="col">@T["LapAnalysis.SectorColumn"]</th>
                    <th scope="col" class="numeric-cell">@T["LapAnalysis.Best"] <span class="th-sub">@T["LapAnalysis.ClassBestGap"]</span></th>
                    <th scope="col" class="numeric-cell">@T["LapAnalysis.Pace"] <span class="th-sub">@T["LapAnalysis.ClassPace"]</span></th>
                    <th scope="col" class="numeric-cell">@T["LapAnalysis.Regularity"]</th>
                    <th scope="col">@T["LapAnalysis.TimeLost"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var sector in Analysis.Sectors)
                {
                    var gap = sector.GapToClassPace;
                    <tr class="@(sector.Number == Analysis.WeakestSector ? "sector-weakest" : null)">
                        <th scope="row">@T["LapAnalysis.SectorShort", sector.Number]</th>
                        <td class="numeric-cell stacked-cell">
                            <span class="@(sector.IsClassBest ? "lap-personal-best" : null)">@FormatSeconds(sector.Best)</span>
                            <span class="cell-sub">@DisplayFormat.Delta(sector.Best - sector.ClassBest)</span>
                        </td>
                        <td class="numeric-cell stacked-cell">
                            <span>@FormatSeconds(sector.Pace)</span>
                            <span class="cell-sub">@FormatSeconds(sector.ClassPace)</span>
                        </td>
                        <td class="numeric-cell">@DisplayFormat.Deviation(sector.Deviation)</td>
                        <td>
                            <div class="sector-loss">
                                <span class="sector-loss-bar">
                                    <i class="@(gap > TimeSpan.Zero ? "is-loss" : "is-best")" style="width: @BarWidth(gap, largestGap)"></i>
                                </span>
                                <span>@DisplayFormat.Delta(gap)</span>
                            </div>
                        </td>
                    </tr>
                }
                <tr class="sector-total">
                    <th scope="row">@T["LapAnalysis.LapColumn"]</th>
                    <td class="numeric-cell stacked-cell">
                        <span class="lap-time">@DisplayFormat.Lap(Analysis.BestLap)</span>
                        <span class="cell-sub">@T["LapAnalysis.IdealLap"] @DisplayFormat.Lap(Analysis.IdealLap)</span>
                    </td>
                    <td class="numeric-cell">@DisplayFormat.Lap(Analysis.Regularity?.Pace)</td>
                    <td class="numeric-cell">@DisplayFormat.Deviation(Analysis.Regularity?.Deviation)</td>
                    <td></td>
                </tr>
            </tbody>
        </table>
    </div>
    <p class="lap-analysis-note">@T["LapAnalysis.SectorNote"]</p>

    <div class="lap-analysis-chart-heading">
        <h3 class="lap-analysis-heading">@T["LapAnalysis.LapTimes"]</h3>
        <div class="segmented" role="group" aria-label="@T["LapAnalysis.MeasureLabel"]">
            @foreach (var option in new int?[] { null, 1, 2, 3 })
            {
                <button type="button" class="@(measure == option ? "is-active" : null)" aria-pressed="@(measure == option ? "true" : "false")"
                        @onclick="() => measure = option">@(option is { } number ? T["LapAnalysis.SectorShort", number] : T["LapAnalysis.LapColumn"])</button>
            }
        </div>
    </div>
    @if (chart is null)
    {
        <p class="incident-empty">@T["LapAnalysis.NoChart"]</p>
    }
    else
    {
        <svg class="story-chart" viewBox="0 0 @chart.Width @Number(chart.Height)" role="img" aria-label="@T["LapAnalysis.ChartLabel", Analysis.DriverName]">
            @foreach (var tick in chart.TimeTicks)
            {
                <line class="story-grid" x1="@Number(chart.PlotLeft)" x2="@Number(chart.PlotRight)" y1="@Number(tick.Position)" y2="@Number(tick.Position)" />
                <g><text class="story-axis" x="@Number(chart.PlotLeft - 8)" y="@Number(tick.Position + 4)" text-anchor="end">@tick.Label</text></g>
            }
            @foreach (var tick in chart.LapTicks)
            {
                <g><text class="story-axis" x="@Number(tick.Position)" y="@Number(chart.PlotBottom + 20)" text-anchor="middle">@tick.Label</text></g>
            }
            @foreach (var pit in chart.PitLaps)
            {
                <line class="story-pit" x1="@Number(pit)" x2="@Number(pit)" y1="@Number(chart.PlotTop)" y2="@Number(chart.PlotBottom)">
                    <title>@T["LapAnalysis.PitLegend"]</title>
                </line>
            }
            @if (chart.PaceY is { } paceY)
            {
                <line class="lap-pace" x1="@Number(chart.PlotLeft)" x2="@Number(chart.PlotRight)" y1="@Number(paceY)" y2="@Number(paceY)">
                    <title>@T["LapAnalysis.PaceLine"]</title>
                </line>
            }
            @foreach (var series in chart.Series)
            {
                <g class="race-line @series.CssClass">
                    @foreach (var segment in series.Segments)
                    {
                        <polyline class="race-line-path" points="@segment" />
                    }
                    @foreach (var point in series.Points)
                    {
                        <circle class="@point.CssClass" cx="@Number(point.X)" cy="@Number(point.Y)" r="4">
                            <title>@point.Title</title>
                        </circle>
                    }
                </g>
            }
        </svg>

        <div class="story-legend" aria-label="@T["Progression.LegendLabel"]">
            <span><i class="race-line-swatch race-line-focus" aria-hidden="true"></i>@Analysis.DriverName</span>
            @if (Player is not null)
            {
                <span><i class="race-line-swatch race-line-player" aria-hidden="true"></i>@T["RaceStory.You"]</span>
            }
            <span><i class="race-line-swatch lap-pace-swatch" aria-hidden="true"></i>@T["LapAnalysis.PaceLine"]</span>
            <span><i class="story-swatch lap-swatch-slow" aria-hidden="true"></i>@T["LapAnalysis.SlowLegend"]</span>
            <span><i class="story-swatch lap-swatch-off" aria-hidden="true"></i>@T["LapAnalysis.ScaleNote"]</span>
            <span><i class="story-swatch story-pit-swatch" aria-hidden="true"></i>@T["LapAnalysis.PitLegend"]</span>
        </div>
    }

    <h3 class="lap-analysis-heading">@T["LapAnalysis.StintLaps"]</h3>
    <div class="table-scroll lap-analysis-laps">
        <table class="data-table lap-analysis-table" data-resizable-columns>
            <thead>
                <tr>
                    <th scope="col">@T["LapAnalysis.LapColumn"]</th>
                    <th scope="col" class="numeric-cell">@T["LapAnalysis.TimeColumn"]</th>
                    @for (var number = 1; number <= 3; number++)
                    {
                        <th scope="col" class="numeric-cell">@T["LapAnalysis.SectorShort", number]</th>
                    }
                    <th scope="col" class="numeric-cell">@T["LapAnalysis.PositionColumn"]</th>
                    <th scope="col" class="numeric-cell">@T["LapAnalysis.TopSpeed"]</th>
                    @if (hasFuel)
                    {
                        <th scope="col" class="numeric-cell">@T["LapAnalysis.FuelColumn"]</th>
                    }
                    @if (hasEnergy)
                    {
                        <th scope="col" class="numeric-cell">@T["LapAnalysis.EnergyColumn"]</th>
                    }
                    @if (hasTyres)
                    {
                        <th scope="col" class="numeric-cell">@T["LapAnalysis.TreadColumn"]</th>
                    }
                    <th scope="col">@T["LapAnalysis.Tyres"]</th>
                    <th scope="col">@T["LapAnalysis.PitColumn"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var lap in Analysis.Laps)
                {
                    <tr class="@(lap.IsRepresentative ? null : "lap-row-slow")">
                        <td>@lap.Number</td>
                        <td class="numeric-cell"><span class="@(lap.Time.HasValue && lap.Time == Analysis.BestLap ? "lap-personal-best" : null)">@DisplayFormat.Lap(lap.Time)</span></td>
                        @for (var number = 1; number <= 3; number++)
                        {
                            var time = lap.SectorTime(number);
                            <td class="numeric-cell"><span class="@SectorClass(time, lap.Time.HasValue, personalBests[number])">@FormatSeconds(time)</span></td>
                        }
                        <td class="numeric-cell">@(lap.Position is { } position ? $"P{position}" : DisplayFormat.Missing)</td>
                        <td class="numeric-cell">@DisplayFormat.Speed(lap.Telemetry.TopSpeed)</td>
                        @if (hasFuel)
                        {
                            <td class="numeric-cell">@Share(lap.Telemetry.Fuel)</td>
                        }
                        @if (hasEnergy)
                        {
                            <td class="numeric-cell">@Share(lap.Telemetry.VirtualEnergy)</td>
                        }
                        @if (hasTyres)
                        {
                            <td class="numeric-cell">@Tyres(lap.Telemetry.TyreWear)</td>
                        }
                        <td>@(LapAnalysisPresentation.FormatCompounds(lap.Telemetry) is { Length: > 0 } compounds ? compounds : DisplayFormat.Missing)</td>
                        <td>@(lap.IsPit ? "●" : string.Empty)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p class="lap-analysis-note">@T["LapAnalysis.LapsNote"]</p>

    <h3 class="lap-analysis-heading">@T["LapAnalysis.StintsAndConsumption"]</h3>
    <div class="table-scroll">
        <table class="data-table lap-analysis-table" data-resizable-columns>
            <thead>
                <tr>
                    <th scope="col">@T["LapAnalysis.StintColumn"]</th>
                    <th scope="col">@T["LapAnalysis.StintLaps"]</th>
                    <th scope="col">@T["LapAnalysis.Tyres"]</th>
                    <th scope="col" class="numeric-cell">@T["LapAnalysis.Pace"]</th>
                    <th scope="col" class="numeric-cell">@T["LapAnalysis.BestLap"]</th>
                    @if (hasFuel)
                    {
                        <th scope="col" class="numeric-cell">@T["LapAnalysis.FuelPerLap"]</th>
                    }
                    @if (hasEnergy)
                    {
                        <th scope="col" class="numeric-cell">@T["LapAnalysis.EnergyPerLap"]</th>
                    }
                    @if (hasTyres)
                    {
                        <th scope="col" class="numeric-cell">@T["LapAnalysis.TyreWear"]</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var stint in Analysis.Stints)
                {
                    <tr>
                        <td>@stint.Number</td>
                        <td>@T["LapAnalysis.StintRange", stint.FirstLap, stint.LastLap] <span class="cell-sub-inline">(@Texts.Plural("LapAnalysis.LapCount", stint.LapCount))</span></td>
                        <td>@(stint.Compounds.Count == 0 ? DisplayFormat.Missing : string.Join(", ", stint.Compounds))</td>
                        <td class="numeric-cell">@DisplayFormat.Lap(stint.Pace)</td>
                        <td class="numeric-cell">@DisplayFormat.Lap(stint.BestLap)</td>
                        @if (hasFuel)
                        {
                            <td class="numeric-cell">@Share(stint.FuelPerLap)</td>
                        }
                        @if (hasEnergy)
                        {
                            <td class="numeric-cell">@Share(stint.EnergyPerLap)</td>
                        }
                        @if (hasTyres)
                        {
                            <td class="numeric-cell">@Tyres(stint.TyreWear)</td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (Analysis.Consumption is { } consumption)
    {
        <ul class="lap-analysis-list">
            @if (consumption.EnergyPerLap is { } energy)
            {
                <li>@T["LapAnalysis.Energy", DisplayFormat.Percent(energy), DisplayFormat.Average(consumption.LapsPerEnergy)]</li>
            }
            @if (consumption.TyreWearPerLap is { } wear)
            {
                <li>@T["LapAnalysis.Wear", DisplayFormat.Percent(wear.FrontLeft), DisplayFormat.Percent(wear.FrontRight), DisplayFormat.Percent(wear.RearLeft), DisplayFormat.Percent(wear.RearRight)]</li>
            }
        </ul>
        <p class="lap-analysis-note">@T["LapAnalysis.StintNote"] @T["LapAnalysis.ConsumptionNote"]</p>
    }
    else
    {
        <p class="lap-analysis-note">@T["LapAnalysis.StintNote"] @T["LapAnalysis.NoConsumption"]</p>
    }
</section>

@code {
    private int? measure;

    /// <summary>
    /// Gets or sets the analysis of the followed driver.
    /// </summary>
    [Parameter, EditorRequired]
    public LapAnalysis Analysis { get; set; } = null!;

    /// <summary>
    /// Gets or sets the analysis of the selected driver of the dashboard, drawn in red on the chart
    /// when they are not the followed driver.
    /// </summary>
    [Parameter]
    public LapAnalysis? Player { get; set; }

    /// <summary>
    /// Marks the best sector of the driver in bold, without colour: coloured times are hard to read
    /// in the tables. Sectors of untimed laps are not compared, as in the race details.
    /// </summary>
    private static string? SectorClass(TimeSpan? time, bool isTimed, TimeSpan? personalBest) =>
        time is not null && isTimed && time == personalBest ? "lap-personal-best" : null;

    /// <summary>
    /// Gives the loss bar its share of the largest loss, so that the sector costing the most fills it.
    /// </summary>
    private static string BarWidth(TimeSpan? gap, double largest) =>
        gap is { } value && value > TimeSpan.Zero && largest > 0
            ? string.Create(System.Globalization.CultureInfo.InvariantCulture, $"{Math.Max(4, 100 * value.TotalSeconds / largest):0.#}%")
            : "0%";

    private static string FormatSeconds(TimeSpan? time) =>
        time is { } value
            ? string.Create(System.Globalization.CultureInfo.InvariantCulture, $"{value.TotalSeconds:0.000}s")
            : DisplayFormat.Missing;

    private static string Share(double? value) =>
        value is { } share ? DisplayFormat.Percent(share) : DisplayFormat.Missing;

    private static string Tyres(TyreWear? wear) =>
        wear is null
            ? DisplayFormat.Missing
            : string.Join(" · ", DisplayFormat.Percent(wear.FrontLeft), DisplayFormat.Percent(wear.FrontRight), DisplayFormat.Percent(wear.RearLeft), DisplayFormat.Percent(wear.RearRight));

    private static string Number(double value) =>
        value.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);
}
