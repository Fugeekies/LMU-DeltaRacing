<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>LMU_DeltaRacing.Tests</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="FluentAssertions" Version="8.2.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.5.1" />
    <PackageReference Include="MSTest.TestFramework" Version="4.5.1" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\assets\Results\*.xml">
      <Link>assets\Results\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\LMU-DeltaRacing.Infrastructure\LMU-DeltaRacing.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\LMU-DeltaRacing.Application\LMU-DeltaRacing.Application.csproj" />
    <ProjectReference Include="..\..\src\LMU-DeltaRacing.Console\LMU-DeltaRacing.Console.csproj" />
    <ProjectReference Include="..\..\src\LMU-DeltaRacing.Presentation\LMU-DeltaRacing.Presentation.csproj" />
    <ProjectReference Include="..\..\src\LMU-DeltaRacing.UI\LMU-DeltaRacing.UI.csproj" />
  </ItemGroup>

</Project>